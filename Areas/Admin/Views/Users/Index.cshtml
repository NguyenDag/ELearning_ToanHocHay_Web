@model UsersIndexVm
@{
    ViewData["Title"] = "Quản lý người dùng";
    var f = Model.Filter;
    string? Sel(bool? v, bool target) => v == target ? "selected" : null;
    string RoleBadge(UserType t) => t switch
    {
        UserType.SystemAdmin => "bg-blue-100 text-blue-700",
        UserType.FinanceManager => "bg-emerald-100 text-emerald-700",
        UserType.ContentEditor or UserType.AcademicReviewer => "bg-indigo-100 text-indigo-700",
        UserType.SupportStaff => "bg-amber-100 text-amber-700",
        UserType.Parent => "bg-purple-100 text-purple-700",
        _ => "bg-gray-100 text-gray-600"
    };
}

<div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-black text-gray-800">Người dùng <span class="text-sm font-semibold text-gray-400">(@Model.Total)</span></h2>
    <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm px-4 py-2 rounded-xl">
        <i class="fa-solid fa-plus mr-1"></i> Tạo tài khoản nhân sự
    </a>
</div>

@if (Model.Failed)
{
    <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3 mb-4">
        <b>Không tải được danh sách người dùng</b> (mã @Model.ErrorStatus): @Model.Error
        <br />Kiểm tra: Backend API đang chạy? Đăng nhập lại? Xem log máy chủ để biết thêm.
    </div>
}

<form method="get" class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 mb-4 grid grid-cols-1 md:grid-cols-6 gap-3 text-sm">
    <input name="Search" value="@f.Search" placeholder="Tìm email / họ tên"
           class="md:col-span-2 border border-gray-200 rounded-lg px-3 py-2" />
    <select name="UserType" class="border border-gray-200 rounded-lg px-3 py-2">
        <option value="">— Vai trò —</option>
        @foreach (var t in Enum.GetValues<UserType>())
        {
            <option value="@t" selected="@(f.UserType == t)">@AdminRoles.Label(t)</option>
        }
    </select>
    <select name="IsActive" class="border border-gray-200 rounded-lg px-3 py-2">
        <option value="">— Hoạt động —</option>
        <option value="true" selected="@Sel(f.IsActive, true)">Đang hoạt động</option>
        <option value="false" selected="@Sel(f.IsActive, false)">Vô hiệu hoá</option>
    </select>
    <select name="Locked" class="border border-gray-200 rounded-lg px-3 py-2">
        <option value="">— Khoá —</option>
        <option value="true" selected="@Sel(f.Locked, true)">Đang khoá</option>
        <option value="false" selected="@Sel(f.Locked, false)">Không khoá</option>
    </select>
    <select name="EmailConfirmed" class="border border-gray-200 rounded-lg px-3 py-2">
        <option value="">— Email —</option>
        <option value="true" selected="@Sel(f.EmailConfirmed, true)">Đã xác nhận</option>
        <option value="false" selected="@Sel(f.EmailConfirmed, false)">Chưa xác nhận</option>
    </select>
    <div class="flex gap-2">
        <select name="PageSize" class="border border-gray-200 rounded-lg px-3 py-2">
            @foreach (var n in new[] { 10, 20, 50, 100 })
            {
                <option value="@n" selected="@(f.PageSize == n)">@n / trang</option>
            }
        </select>
        <button class="flex-1 bg-gray-800 text-white font-bold px-4 rounded-lg">Lọc</button>
    </div>
</form>

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
            <tr>
                <th class="text-left px-4 py-3">Người dùng</th>
                <th class="text-left px-4 py-3">Vai trò</th>
                <th class="text-left px-4 py-3">Trạng thái</th>
                <th class="text-left px-4 py-3">Đăng nhập gần nhất</th>
                <th class="px-4 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
        @foreach (var u in Model.Items)
        {
            <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                    <p class="font-bold text-gray-800">@u.FullName</p>
                    <p class="text-gray-400">@u.Email</p>
                </td>
                <td class="px-4 py-3">
                    <span class="px-2 py-1 rounded-full text-xs font-bold @RoleBadge(u.UserType)">@AdminRoles.Label(u.UserType)</span>
                </td>
                <td class="px-4 py-3 space-x-1">
                    @if (u.IsLocked)
                    {
                        <span class="px-2 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700">Đã khoá</span>
                    }
                    else if (!u.IsActive)
                    {
                        <span class="px-2 py-1 rounded-full text-xs font-bold bg-gray-200 text-gray-600">Vô hiệu hoá</span>
                    }
                    else
                    {
                        <span class="px-2 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">Hoạt động</span>
                    }
                    @if (!u.IsEmailConfirmed)
                    {
                        <span class="px-2 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700">Chưa xác nhận email</span>
                    }
                </td>
                <td class="px-4 py-3 text-gray-500">@(u.LastLogin?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                <td class="px-4 py-3 text-right">
                    <a asp-action="Details" asp-route-id="@u.UserId" class="text-blue-600 font-bold hover:underline">Chi tiết</a>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="5" class="px-4 py-10 text-center text-gray-400">Không có người dùng nào khớp bộ lọc.</td></tr>
        }
        </tbody>
    </table>
</div>

@{
    var users_rv = new Dictionary<string, string>
    {
        ["PageSize"] = f.PageSize.ToString(),
        ["Search"] = f.Search ?? "",
        ["UserType"] = f.UserType?.ToString() ?? "",
        ["IsActive"] = f.IsActive?.ToString() ?? "",
        ["Locked"] = f.Locked?.ToString() ?? "",
        ["EmailConfirmed"] = f.EmailConfirmed?.ToString() ?? ""
    };
}
@if (Model.TotalPages > 1)
{
    <div class="flex justify-between items-center mt-4 text-sm">
        <span class="text-gray-400">Trang @Model.Page / @Model.TotalPages · @Model.Total tài khoản</span>
        <div class="flex gap-1 flex-wrap">
            @for (var p = Math.Max(1, Model.Page - 3); p <= Math.Min(Model.TotalPages, Model.Page + 3); p++)
            {
                <a asp-action="Index" asp-route-Page="@p" asp-all-route-data="users_rv"
                   class="w-9 h-9 flex items-center justify-center rounded-lg font-bold @(p == Model.Page ? "bg-blue-600 text-white" : "bg-white border border-gray-200 text-gray-600")">@p</a>
            }
        </div>
    </div>
}
