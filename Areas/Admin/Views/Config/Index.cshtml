@model ConfigIndexVm
@{
    ViewData["Title"] = "Cấu hình hệ thống";
}

<h2 class="text-xl font-black text-gray-800 mb-1">Cấu hình hệ thống</h2>
<p class="text-sm text-gray-500 mb-4">Tham số vận hành. Thay đổi có hiệu lực sau tối đa 5 phút (bộ nhớ đệm).</p>

<div class="flex flex-wrap gap-2 mb-5">
    @foreach (var g in Model.Groups)
    {
        <a asp-action="Index" asp-route-group="@g.Key"
           class="px-3 py-1.5 rounded-full text-sm font-bold @(g.Key == Model.ActiveGroup ? "bg-blue-600 text-white" : "bg-white border border-gray-200 text-gray-600")">
            @g.Key <span class="opacity-60">@g.Count()</span>
        </a>
    }
</div>

@foreach (var g in Model.Groups.Where(g => g.Key == Model.ActiveGroup))
{
    <div class="space-y-3">
        @foreach (var c in g.OrderBy(x => x.ConfigKey))
        {
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
                <form method="post" asp-action="Set" class="flex flex-col md:flex-row md:items-center gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="key" value="@c.ConfigKey" />
                    <input type="hidden" name="group" value="@Model.ActiveGroup" />
                    <div class="md:w-2/5">
                        <p class="font-bold text-gray-800 text-sm">@c.ConfigKey</p>
                        <p class="text-gray-400 text-xs">@c.Description</p>
                        <p class="text-gray-300 text-[11px] mt-0.5">
                            @c.ConfigType@(c.UpdatedByName != null ? $" · sửa bởi {c.UpdatedByName}" : "") · @c.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>
                    <div class="flex-1 flex gap-2">
                        @if (c.IsBool)
                        {
                            <select name="value" class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm">
                                <option value="true" selected="@(string.Equals(c.ConfigValue, "true", StringComparison.OrdinalIgnoreCase))">true</option>
                                <option value="false" selected="@(!string.Equals(c.ConfigValue, "true", StringComparison.OrdinalIgnoreCase))">false</option>
                            </select>
                        }
                        else
                        {
                            <input name="value" type="@c.InputType" value="@c.ConfigValue" step="any"
                                   class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm" />
                        }
                        <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm px-4 rounded-lg">Lưu</button>
                    </div>
                </form>
            </div>
        }
    </div>
}
