@model CourseListVm
@{
    ViewData["Title"] = "Khoá học";
    string Badge(CourseStatus s) => s switch
    {
        CourseStatus.Published => "bg-green-100 text-green-700",
        CourseStatus.Archived => "bg-gray-200 text-gray-600",
        _ => "bg-amber-100 text-amber-700"
    };
}

<div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-black text-gray-800">Khoá học <span class="text-sm font-semibold text-gray-400">(@Model.Total)</span></h2>
    <div class="flex gap-2">
        <a asp-action="Catalog" class="bg-white border border-gray-200 text-gray-600 font-bold text-sm px-4 py-2 rounded-xl">Danh mục</a>
        <a asp-action="CreateCourse" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm px-4 py-2 rounded-xl">
            <i class="fa-solid fa-plus mr-1"></i> Tạo khoá học
        </a>
    </div>
</div>

@if (Model.Failed)
{
    <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3 mb-4">
        <b>Không tải được danh sách khoá học</b> (mã @Model.ErrorStatus): @Model.Error
    </div>
}

<form method="get" class="bg-white rounded-2xl p-4 shadow-sm border border-gray-100 mb-4 flex flex-wrap gap-3 text-sm">
    <input name="search" value="@Model.Search" placeholder="Tìm tiêu đề / slug" class="flex-1 min-w-[180px] border border-gray-200 rounded-lg px-3 py-2" />
    <select name="subjectId" class="border border-gray-200 rounded-lg px-3 py-2">
        <option value="">— Môn —</option>
        @foreach (var s in Model.Subjects)
        {
            <option value="@s.Id" selected="@(Model.SubjectId == s.Id)">@s.Name</option>
        }
    </select>
    <select name="gradeLevelId" class="border border-gray-200 rounded-lg px-3 py-2">
        <option value="">— Lớp —</option>
        @foreach (var g in Model.Grades)
        {
            <option value="@g.Id" selected="@(Model.GradeLevelId == g.Id)">@g.Name</option>
        }
    </select>
    <select name="pageSize" class="border border-gray-200 rounded-lg px-3 py-2">
        @foreach (var n in new[] { 10, 20, 50, 100 })
        {
            <option value="@n" selected="@(Model.PageSize == n)">@n / trang</option>
        }
    </select>
    <button class="bg-gray-800 text-white font-bold px-4 rounded-lg">Lọc</button>
</form>

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase">
            <tr>
                <th class="text-left px-4 py-3">Khoá học</th>
                <th class="text-left px-4 py-3">Môn / Lớp</th>
                <th class="text-left px-4 py-3">Trạng thái</th>
                <th class="text-center px-4 py-3">Bản xuất bản</th>
                <th class="px-4 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
        @foreach (var c in Model.Courses)
        {
            <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                    <p class="font-bold text-gray-800">@c.Title</p>
                    <p class="text-gray-400 text-xs">@c.Slug</p>
                </td>
                <td class="px-4 py-3 text-gray-600">@c.SubjectName / @c.GradeLevelName</td>
                <td class="px-4 py-3"><span class="px-2 py-1 rounded-full text-xs font-bold @Badge(c.Status)">@ContentEnums.CourseStatusLabel(c.Status)</span></td>
                <td class="px-4 py-3 text-center">@(c.PublishedVersionNumber.HasValue ? $"v{c.PublishedVersionNumber}" : "—")</td>
                <td class="px-4 py-3 text-right">
                    <a asp-action="Course" asp-route-id="@c.CourseId" class="text-blue-600 font-bold hover:underline">Mở</a>
                </td>
            </tr>
        }
        @if (Model.Courses.Count == 0 && !Model.Failed)
        {
            <tr><td colspan="5" class="px-4 py-10 text-center text-gray-400">Chưa có khoá học nào.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="flex justify-between items-center mt-4 text-sm">
        <span class="text-gray-400">Trang @Model.Page / @Model.TotalPages · @Model.Total khoá học</span>
        <div class="flex gap-1 flex-wrap">
            @for (var p = Math.Max(1, Model.Page - 3); p <= Math.Min(Model.TotalPages, Model.Page + 3); p++)
            {
                <a asp-action="Courses" asp-route-page="@p" asp-route-pageSize="@Model.PageSize"
                   asp-route-search="@Model.Search" asp-route-subjectId="@Model.SubjectId" asp-route-gradeLevelId="@Model.GradeLevelId"
                   class="w-9 h-9 flex items-center justify-center rounded-lg font-bold @(p == Model.Page ? "bg-blue-600 text-white" : "bg-white border border-gray-200 text-gray-600")">@p</a>
            }
        </div>
    </div>
}
