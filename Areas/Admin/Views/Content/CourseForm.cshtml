@model CourseEditVm
@{
    var isEdit = Model.CourseId > 0;
    ViewData["Title"] = isEdit ? "Sửa khoá học" : "Tạo khoá học";
    var subjects = ViewBag.Subjects as List<CatalogRefDto> ?? new();
    var grades = ViewBag.Grades as List<CatalogRefDto> ?? new();
    var frameworks = ViewBag.Frameworks as List<CatalogRefDto> ?? new();
}

<div class="max-w-2xl">
    <a asp-action="Courses" class="text-sm text-gray-500 hover:underline"><i class="fa-solid fa-arrow-left mr-1"></i> Khoá học</a>
    <h2 class="text-xl font-black text-gray-800 mt-2 mb-4">@ViewData["Title"]</h2>

    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <form method="post" asp-action="@(isEdit ? "EditCourse" : "CreateCourse")" asp-route-id="@(isEdit ? Model.CourseId : (int?)null)">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CourseId" />
            <div asp-validation-summary="All" class="text-red-600 text-sm mb-2"></div>

            <div class="space-y-4 text-sm">
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Tiêu đề</label>
                    <input asp-for="Title" class="w-full border border-gray-200 rounded-lg px-3 py-2" />
                    <span asp-validation-for="Title" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Slug</label>
                    <input asp-for="Slug" class="w-full border border-gray-200 rounded-lg px-3 py-2" />
                    <span asp-validation-for="Slug" class="text-red-600 text-xs"></span>
                </div>
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Môn</label>
                        <select asp-for="SubjectId" class="w-full border border-gray-200 rounded-lg px-3 py-2">
                            <option value="">—</option>
                            @foreach (var s in subjects) { <option value="@s.Id">@s.Name</option> }
                        </select>
                        <span asp-validation-for="SubjectId" class="text-red-600 text-xs"></span>
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Lớp</label>
                        <select asp-for="GradeLevelId" class="w-full border border-gray-200 rounded-lg px-3 py-2">
                            <option value="">—</option>
                            @foreach (var g in grades) { <option value="@g.Id">@g.Name</option> }
                        </select>
                        <span asp-validation-for="GradeLevelId" class="text-red-600 text-xs"></span>
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Bộ sách</label>
                        <select asp-for="FrameworkId" class="w-full border border-gray-200 rounded-lg px-3 py-2">
                            <option value="">—</option>
                            @foreach (var fw in frameworks) { <option value="@fw.Id">@fw.Name</option> }
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Mô tả</label>
                    <textarea asp-for="Description" rows="3" class="w-full border border-gray-200 rounded-lg px-3 py-2"></textarea>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">Ảnh bìa (URL)</label>
                    <input asp-for="ThumbnailUrl" class="w-full border border-gray-200 rounded-lg px-3 py-2" />
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Giá niêm yết</label>
                        <input asp-for="ListPrice" type="number" step="any" class="w-full border border-gray-200 rounded-lg px-3 py-2" />
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Giá KM</label>
                        <input asp-for="SalePrice" type="number" step="any" class="w-full border border-gray-200 rounded-lg px-3 py-2" />
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Số ngày truy cập</label>
                        <input asp-for="AccessDurationDays" type="number" class="w-full border border-gray-200 rounded-lg px-3 py-2" />
                    </div>
                    <div>
                        <label class="block font-bold text-gray-700 mb-1">Thứ tự</label>
                        <input asp-for="DisplayOrder" type="number" class="w-full border border-gray-200 rounded-lg px-3 py-2" />
                    </div>
                </div>
                <label class="flex items-center gap-2 font-bold text-gray-700">
                    <input asp-for="IsPurchasable" type="checkbox" /> Cho phép mua lẻ
                </label>
            </div>

            <button type="submit" class="mt-5 bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2.5 rounded-xl">
                @(isEdit ? "Lưu" : "Tạo")
            </button>
        </form>
    </div>
</div>
