@{
    ViewData["Title"] = "Tổng quan quản trị";
}

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition">
        <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-3"><i class="fa-solid fa-users"></i></div>
        <p class="font-black text-gray-800">Người dùng</p>
        <p class="text-sm text-gray-500">Tạo staff, khoá/mở, đổi vai trò, đặt lại mật khẩu</p>
    </a>
    <a asp-area="Admin" asp-controller="Content" asp-action="Courses" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition">
        <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3"><i class="fa-solid fa-book"></i></div>
        <p class="font-black text-gray-800">Khoá học &amp; bài học</p>
        <p class="text-sm text-gray-500">Danh mục, khoá học, phiên bản, cây nội dung</p>
    </a>
    <a asp-area="Admin" asp-controller="Config" asp-action="Index" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition">
        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center mb-3"><i class="fa-solid fa-sliders"></i></div>
        <p class="font-black text-gray-800">Cấu hình hệ thống</p>
        <p class="text-sm text-gray-500">Ngưỡng, giới hạn, tham số vận hành</p>
    </a>
    <a asp-area="Admin" asp-controller="AuditLog" asp-action="Index" class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition">
        <div class="w-11 h-11 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center mb-3"><i class="fa-solid fa-clock-rotate-left"></i></div>
        <p class="font-black text-gray-800">Nhật ký</p>
        <p class="text-sm text-gray-500">Toàn bộ thao tác quản trị đã ghi lại</p>
    </a>
</div>

<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
    <p class="text-sm text-gray-500">
        Khu quản trị đang được xây dựng theo từng pha. Các số liệu tổng quan sẽ hiển thị ở đây khi
        các module tương ứng hoàn thiện.
    </p>
</div>
