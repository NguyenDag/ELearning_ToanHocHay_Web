@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    string NavClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "flex items-center gap-3 px-4 py-2.5 rounded-xl bg-blue-600 text-white font-bold text-sm"
            : "flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-600 hover:bg-blue-50 hover:text-blue-700 font-semibold text-sm transition";

    var adminName = User.Identity?.Name ?? "Quản trị viên";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Quản trị ToanHocHay</title>
    <link rel="icon" type="image/x-icon" href="/logo_header.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="~/js/toast.js" asp-append-version="true" defer></script>
    <style>body { font-family: 'Nunito', sans-serif; }</style>
    @RenderSection("Styles", required: false)
</head>
<body class="bg-gray-100 text-gray-800 min-h-screen">
<div class="flex min-h-screen">

    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col flex-shrink-0">
        <div class="px-6 py-5 border-b border-gray-100">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-blue-600 text-xl"></i>
                <span class="font-black text-lg text-gray-800">Quản trị</span>
            </a>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@NavClass("Dashboard")">
                <i class="fa-solid fa-gauge-high w-5 text-center"></i> Tổng quan
            </a>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="@NavClass("Users")">
                <i class="fa-solid fa-users w-5 text-center"></i> Người dùng
            </a>
            <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="@NavClass("Roles")">
                <i class="fa-solid fa-user-shield w-5 text-center"></i> Phân quyền
            </a>
            <a asp-area="Admin" asp-controller="Content" asp-action="Courses" class="@NavClass("Content")">
                <i class="fa-solid fa-book w-5 text-center"></i> Khoá học &amp; bài học
            </a>
            <a asp-area="Admin" asp-controller="Exercises" asp-action="Index" class="@NavClass("Exercises")">
                <i class="fa-solid fa-pen-to-square w-5 text-center"></i> Bài kiểm tra
            </a>
            <a asp-area="Admin" asp-controller="QuestionBanks" asp-action="Index" class="@NavClass("QuestionBanks")">
                <i class="fa-solid fa-layer-group w-5 text-center"></i> Ngân hàng câu hỏi
            </a>
            <a asp-area="Admin" asp-controller="Config" asp-action="Index" class="@NavClass("Config")">
                <i class="fa-solid fa-sliders w-5 text-center"></i> Cấu hình hệ thống
            </a>
            <a asp-area="Admin" asp-controller="AuditLog" asp-action="Index" class="@NavClass("AuditLog")">
                <i class="fa-solid fa-clock-rotate-left w-5 text-center"></i> Nhật ký
            </a>
        </nav>

        <div class="px-3 py-4 border-t border-gray-100">
            <a href="/" class="flex items-center gap-3 px-4 py-2 rounded-xl text-gray-500 hover:bg-gray-50 text-sm font-semibold">
                <i class="fa-solid fa-arrow-left w-5 text-center"></i> Về trang chính
            </a>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between">
            <h1 class="font-bold text-gray-700">@ViewData["Title"]</h1>
            <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-gray-600">@adminName</span>
                <span class="text-[11px] font-black uppercase tracking-wide text-blue-600 bg-blue-50 px-2 py-1 rounded">SystemAdmin</span>
                <a href="/Account/Logout" class="text-sm font-bold text-red-600 hover:underline">
                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                </a>
            </div>
        </header>

        <main class="flex-1 p-6">
            @RenderBody()
        </main>
    </div>
</div>

<partial name="_ToastHost" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
