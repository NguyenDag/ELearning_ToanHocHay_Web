@model QuestionBankVm
@{
    ViewData["Title"] = "Sửa ngân hàng câu hỏi";
    int bankId = ViewBag.BankId;
}

<div class="max-w-2xl">
    <a asp-action="Questions" asp-route-bankId="@bankId" class="text-sm text-gray-500 hover:underline"><i class="fa-solid fa-arrow-left mr-1"></i> Câu hỏi</a>
    <h2 class="text-xl font-black text-gray-800 mt-2 mb-4">Sửa ngân hàng câu hỏi</h2>
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <form method="post" asp-action="Edit" asp-route-bankId="@bankId">
            @Html.AntiForgeryToken()
            <partial name="_BankForm" model="Model" />
            <button type="submit" class="mt-5 bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2.5 rounded-xl">Lưu</button>
        </form>
    </div>
    <form method="post" asp-action="Delete" asp-route-bankId="@bankId" class="mt-3"
          onsubmit="return confirm('Xoá ngân hàng câu hỏi này?');">
        @Html.AntiForgeryToken()
        <button class="text-red-600 font-bold text-sm hover:underline">Xoá ngân hàng</button>
    </form>
</div>
