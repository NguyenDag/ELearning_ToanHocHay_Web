@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
    Layout = "_Layout";
}

<div class="container mx-auto px-4 py-16 max-w-xl text-center">
    <div class="text-6xl font-black text-[#1e3a5f]">@(Model.StatusCode?.ToString() ?? "!")</div>
    <h1 class="mt-4 text-2xl font-bold text-gray-800">@Model.Message</h1>

    <div class="mt-6 flex justify-center gap-3">
        <a href="/" class="px-5 py-2.5 rounded-lg bg-[#1e3a5f] text-white font-semibold hover:bg-[#2a4074]">
            Về trang chủ
        </a>
        <a href="javascript:history.back()" class="px-5 py-2.5 rounded-lg border border-gray-300 font-semibold hover:bg-gray-50">
            Quay lại
        </a>
    </div>

    @if (Model.ShowCorrelationId || Model.ShowRequestId)
    {
        <p class="mt-8 text-xs text-gray-400">
            Mã tra cứu sự cố:
            <code class="text-gray-500">@(Model.CorrelationId ?? Model.RequestId)</code>
            <br />Vui lòng gửi mã này cho bộ phận hỗ trợ nếu lỗi lặp lại.
        </p>
    }
</div>
