@using ToanHocHay.WebApp.Services.Http
@{
    var apiError = TempData[ApiResultExtensions.TempDataError] as string;
    var apiSuccess = TempData[ApiResultExtensions.TempDataSuccess] as string;
    var apiCorr = TempData[ApiResultExtensions.TempDataCorrelation] as string;
}

@if (!string.IsNullOrEmpty(apiSuccess))
{
    <div class="container mx-auto px-4 mt-4">
        <div class="rounded-lg border border-green-200 bg-green-50 text-green-800 px-4 py-3 text-sm">
            @apiSuccess
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(apiError))
{
    <div class="container mx-auto px-4 mt-4">
        <div class="rounded-lg border border-red-200 bg-red-50 text-red-800 px-4 py-3 text-sm">
            @apiError
            @if (!string.IsNullOrEmpty(apiCorr))
            {
                <span class="block mt-1 text-xs text-red-500">Mã tra cứu: <code>@apiCorr</code></span>
            }
        </div>
    </div>
}
