@using ToanHocHay.WebApp.Models.DTOs
@model ExerciseResultDto
@{
    Layout = null;
    if (Model == null) return;

    var title = Model.ExerciseName;
    var score = Model.TotalScore.ToString("0.##");
    var totalQs = Model.TotalQuestions;
    var correctCount = Model.CorrectAnswers;
    var wrongCount = Model.WrongAnswers;
    var skippedCount = totalQs - (correctCount + wrongCount);
    var time = $"{(int)Model.Duration.TotalMinutes}:{Model.Duration.Seconds:D2}";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review: @title - ToanHocHay</title>
    <link rel="icon" type="image/x-icon" href="/logo_header.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Nunito', sans-serif; }
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        .q-status-correct { background-color: #52B986; color: white; border: none; }
        .q-status-wrong { background-color: #E15554; color: white; border: none; }
        .q-status-skipped { background-color: white; color: #6B7280; border: 1px solid #E5E7EB; }
        html { scroll-behavior: smooth; }
    </style>
</head>
<body class="bg-[#E0E7FF] h-screen flex items-center justify-center p-4 md:p-6 overflow-hidden">

    <div class="w-full max-w-[1400px] h-[90vh] flex gap-6">

        <!-- 1. LEFT SIDEBAR (Question Navigation) -->
        <aside class="w-80 bg-white rounded-2xl shadow-xl flex flex-col overflow-hidden border border-blue-100 shrink-0 hidden lg:flex z-20">
            <div class="p-5 border-b border-blue-50 bg-blue-50/30 text-center">
                <h3 class="text-blue-800 font-extrabold text-lg flex items-center justify-center gap-2">
                    <i class="fa-solid fa-table-cells text-blue-600"></i> Danh sách câu hỏi
                </h3>
            </div>

            <div class="p-6 flex-1 overflow-y-auto custom-scroll">
                <div class="grid grid-cols-3 gap-2 mb-6">
                    <div class="bg-green-50 p-2 rounded-xl border border-green-100 text-center">
                        <span class="block text-[#52B986] font-black text-xl">@correctCount</span>
                        <span class="text-[9px] text-[#52B986] font-bold uppercase">Đúng</span>
                    </div>
                    <div class="bg-red-50 p-2 rounded-xl border border-red-100 text-center">
                        <span class="block text-[#E15554] font-black text-xl">@wrongCount</span>
                        <span class="text-[9px] text-[#E15554] font-bold uppercase">Sai</span>
                    </div>
                    <div class="bg-gray-50 p-2 rounded-xl border border-gray-200 text-center">
                        <span class="block text-gray-500 font-black text-xl">@skippedCount</span>
                        <span class="text-[9px] text-gray-500 font-bold uppercase">Bỏ qua</span>
                    </div>
                </div>

                <hr class="border-gray-100 mb-6">

                <div class="grid grid-cols-5 gap-2">
                    @for (int i = 0; i < Model.AnswerDetails.Count; i++)
                    {
                        var detail = Model.AnswerDetails[i];
                        bool isSkipped = detail.StudentAnswer == "Bạn chưa trả lời câu hỏi này";
                        var statusClass = isSkipped ? "q-status-skipped" : (detail.IsCorrect ? "q-status-correct" : "q-status-wrong");
                        <a href="#q@(i+1)" class="@statusClass w-10 h-10 rounded-lg flex items-center justify-center font-bold text-sm shadow-sm hover:opacity-90 transition">@(i + 1)</a>
                    }
                </div>
            </div>

            <div class="p-4 border-t border-gray-100 bg-white">
                <a href="/Exam/Result?attemptId=@Model.AttemptId" class="flex items-center justify-center gap-2 w-full py-2 text-gray-500 font-bold text-sm hover:text-gray-800 transition">
                    <i class="fa-solid fa-arrow-left"></i> Thoát về Kết quả
                </a>
            </div>
        </aside>

        <!-- 2. MAIN CONTENT (Review Questions) -->
        <main class="flex-1 flex flex-col gap-4 overflow-hidden">
            <div class="bg-white rounded-2xl shadow-sm border border-blue-100 p-3 px-6 flex justify-between items-center shrink-0">
                <div class="flex items-center gap-4">
                    <div class="bg-blue-600 text-white rounded-xl p-2 min-w-[64px] text-center shadow-lg shadow-blue-200">
                        <span class="block text-xl font-black leading-none">@score</span>
                        <span class="text-[10px] font-medium opacity-90">Điểm</span>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold text-gray-800 leading-tight">@title</h1>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="text-[10px] font-bold @(Model.IsPassed ? "text-green-600 bg-green-50 border-green-100" : "text-red-600 bg-red-50 border-red-100") px-2 py-0.5 rounded border">
                                <i class="fa-solid @(Model.IsPassed ? "fa-check-circle" : "fa-triangle-exclamation") mr-1"></i> @(Model.IsPassed ? "Đạt yêu cầu" : "Chưa đạt")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-slate-50 text-slate-600 px-4 py-2 rounded-lg text-sm font-bold border border-slate-100">
                    <i class="fa-regular fa-clock text-blue-500"></i>
                    <span>Thời gian: @time</span>
                </div>
            </div>

            <div class="flex-1 bg-white rounded-3xl shadow-xl border border-blue-50 relative overflow-hidden">
                <div class="h-full overflow-y-auto custom-scroll p-8 md:p-12 scroll-smooth" id="questions-container">
                    @for (int i = 0; i < Model.AnswerDetails.Count; i++)
                    {
                        var detail = Model.AnswerDetails[i];
                        bool isSkipped = detail.StudentAnswer == "Bạn chưa trả lời câu hỏi này" || string.IsNullOrEmpty(detail.StudentAnswer);
                        
                        <div id="q@(i+1)" class="mb-12 scroll-mt-6">
                            <div class="flex justify-between items-start mb-4">
                                <div class="flex gap-3">
                                    <span class="@(isSkipped ? "bg-gray-400" : (detail.IsCorrect ? "bg-[#52B986]" : "bg-[#E15554]")) text-white font-black text-sm px-2.5 py-1 rounded shadow-sm h-fit">Q@(i+1)</span>
                                    <h2 class="text-lg font-bold text-gray-800 leading-relaxed">@detail.QuestionText</h2>
                                </div>
                                <span class="@(isSkipped ? "text-gray-500 bg-gray-50 border-gray-100" : (detail.IsCorrect ? "text-[#52B986] bg-green-50 border-green-100" : "text-[#E15554] bg-red-50 border-red-100")) text-xs font-bold px-2 py-1 rounded border shrink-0">
                                    <i class="fa-solid @(isSkipped ? "fa-minus" : (detail.IsCorrect ? "fa-check" : "fa-xmark")) mr-1"></i> @(isSkipped ? "Bỏ qua" : (detail.IsCorrect ? "Đúng" : "Sai")) (+@detail.PointsEarned/@detail.MaxScores đ)
                                </span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                                    <p class="text-[10px] font-black text-gray-400 uppercase mb-1">Đáp án của bạn</p>
                                    <p class="font-bold @(isSkipped ? "text-gray-400 italic" : (detail.IsCorrect ? "text-green-600" : "text-red-600"))">@detail.StudentAnswer</p>
                                </div>
                                <div class="p-4 rounded-2xl bg-blue-50 border border-blue-100">
                                    <p class="text-[10px] font-black text-blue-400 uppercase mb-1">Đáp án đúng</p>
                                    <p class="font-bold text-blue-700">@detail.CorrectAnswer</p>
                                </div>
                            </div>

                            <!-- AI Feedback Area -->
                            <div class="mt-6 space-y-3">
                                @if (!string.IsNullOrEmpty(detail.FullSolution))
                                {
                                    <div class="p-5 bg-indigo-600 text-white rounded-[1.5rem] shadow-lg shadow-indigo-100">
                                        <div class="flex items-center gap-2 mb-2 text-indigo-200">
                                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                                            <span class="text-[10px] font-black uppercase tracking-widest">Lời giải chi tiết AI</span>
                                        </div>
                                        <div class="text-sm leading-relaxed prose prose-invert overflow-x-auto">@detail.FullSolution</div>
                                    </div>
                                }
                                else if (!detail.IsCorrect && !isSkipped)
                                {
                                    <div class="p-4 bg-amber-50 border border-amber-100 rounded-2xl flex items-center gap-3">
                                        <i class="fa-solid fa-robot fa-bounce text-amber-500"></i>
                                        <p class="text-xs font-bold text-amber-700">AI đang phân tích lỗi của bạn... Bạn hãy đợi vài giây rồi thử tải lại trang nhé!</p>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(detail.MistakeAnalysis))
                                {
                                    <div class="p-5 bg-red-50 border border-red-100 rounded-[1.5rem]">
                                        <div class="flex items-center gap-2 mb-2 text-red-600">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            <span class="text-[10px] font-black uppercase tracking-widest">Phân tích lỗi sai</span>
                                        </div>
                                        <p class="text-sm text-red-800">@detail.MistakeAnalysis</p>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(detail.ImprovementAdvice))
                                {
                                    <div class="p-5 bg-green-50 border border-green-100 rounded-[1.5rem]">
                                        <div class="flex items-center gap-2 mb-2 text-green-600">
                                            <i class="fa-solid fa-lightbulb"></i>
                                            <span class="text-[10px] font-black uppercase tracking-widest">Lời khuyên cải thiện</span>
                                        </div>
                                        <p class="text-sm text-green-800">@detail.ImprovementAdvice</p>
                                    </div>
                                }
                                
                                @if (string.IsNullOrEmpty(detail.FullSolution) && !string.IsNullOrEmpty(detail.Explanation))
                                {
                                    <div class="p-4 bg-slate-50 border border-gray-100 rounded-xl text-xs text-gray-500">
                                        <strong>Gợi ý từ hệ thống:</strong> @detail.Explanation
                                    </div>
                                }
                            </div>
                        </div>
                        @if (i < Model.AnswerDetails.Count - 1) { <hr class="border-dashed border-gray-100 my-8"> }
                    }
                    <div class="h-20"></div>
                </div>
            </div>
        </main>
    </div>

    <!-- MathJax -->
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
</body>
</html>