@using ToanHocHay.WebApp.Models.DTOs
@{
    ViewData["Title"] = "Thư viện đề thi Lớp 6";
    var completedIds = ViewData["CompletedIds"] as List<int> ?? new List<int>();
}

@functions {
    string GetDurationLabel(int? minutes)
    {
        if (!minutes.HasValue) return "Không giới hạn";
        return minutes.Value switch
        {
            45 => "1 Tiết (45p)",
            90 => "Cuối kỳ (90p)",
            _ => $"{minutes} phút"
        };
    }

    string GetDurationColor(int? minutes)
    {
        return minutes switch
        {
            45 => "#F97316",
            90 => "#EF4444",
            _ => "#6366F1"
        };
    }
}

@model List<ExerciseDto>

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>

<style>
    body {
        font-family: 'Nunito', sans-serif;
    }

    .exam-card {
        background: white;
        border-radius: 1.5rem;
        border: 1px solid #F1F5F9;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
        transition: all .25s ease;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

        .exam-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0,0,0,.08);
        }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fade-up {
        animation: fadeUp .4s ease both;
    }

    .page-btn {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: .6rem;
        border: 1px solid #E2E8F0;
        background: white;
        color: #64748b;
        font-weight: 800;
        font-size: .8rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .2s;
        font-family: 'Nunito', sans-serif;
    }

        .page-btn:hover {
            background: #EEF2FF;
            color: #6366f1;
            border-color: #C7D2FE;
        }

        .page-btn.active {
            background: #6366f1;
            color: white;
            border-color: #6366f1;
            box-shadow: 0 4px 12px rgba(99,102,241,.3);
        }

        .page-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }
</style>

<!-- HERO -->
<section class="relative bg-gradient-to-br from-blue-700 via-indigo-700 to-purple-800 text-white pt-16 pb-28 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-white opacity-10 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-yellow-400 opacity-10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

    <div class="container mx-auto px-4 relative z-10 text-center">
        <div class="max-w-3xl mx-auto">
            <span class="inline-block bg-white/20 backdrop-blur-sm text-white text-[10px] font-black px-4 py-2 rounded-full mb-6 border border-white/30 tracking-widest uppercase">
                <i class="fa-solid fa-file-signature mr-2"></i> Thư viện đề thi Lớp 6
            </span>
            <h1 class="text-4xl md:text-5xl font-black mb-6 leading-tight">
                Thư viện Đề thi<br>
                <span class="text-yellow-300">Thông minh & Hiệu quả</span>
            </h1>
            <p class="text-blue-100 font-bold mb-10 max-w-xl mx-auto">
                Tổng hợp đề thi bám sát chương trình GDPT mới. Hệ thống tự động chấm điểm và cung cấp lời giải chi tiết ngay lập tức.
            </p>

            <!-- Search -->
            <div class="max-w-xl mx-auto bg-white p-2 rounded-2xl shadow-2xl flex items-center">
                <div class="flex-1 px-4 flex items-center">
                    <i class="fa-solid fa-magnifying-glass text-gray-400 mr-3"></i>
                    <input type="text" id="search-input" placeholder="Tìm kiếm đề thi..."
                           class="w-full bg-transparent outline-none text-gray-800 placeholder-gray-400 font-bold text-sm h-11"
                           oninput="filterExams()">
                </div>
                <button class="bg-indigo-600 hover:bg-indigo-700 text-white font-black py-3 px-6 rounded-xl transition text-sm">
                    Tìm
                </button>
            </div>
        </div>
    </div>
</section>

<!-- MAIN -->
<section class="bg-[#F4F7FE] py-10 -mt-10 relative z-20 rounded-t-[2rem]">
    <div class="container mx-auto px-4 max-w-6xl">

        <!-- Stats + Filter bar -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-8 bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
            <div class="flex gap-2 overflow-x-auto w-full sm:w-auto hide-scrollbar">
                <button onclick="setFilter('all')" id="filter-all" class="filter-btn px-4 py-2 rounded-xl bg-indigo-600 text-white font-bold text-xs whitespace-nowrap transition">Tất cả</button>
                <button onclick="setFilter('free')" id="filter-free" class="filter-btn px-4 py-2 rounded-xl bg-gray-100 text-gray-600 font-bold text-xs hover:bg-indigo-50 hover:text-indigo-600 whitespace-nowrap transition">🟢 Miễn phí</button>
                <button onclick="setFilter('premium')" id="filter-premium" class="filter-btn px-4 py-2 rounded-xl bg-gray-100 text-gray-600 font-bold text-xs hover:bg-indigo-50 hover:text-indigo-600 whitespace-nowrap transition">⭐ Premium</button>
                <button onclick="setFilter('done')" id="filter-done" class="filter-btn px-4 py-2 rounded-xl bg-gray-100 text-gray-600 font-bold text-xs hover:bg-green-50 hover:text-green-600 whitespace-nowrap transition">✅ Đã làm</button>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-400 font-bold">
                <span id="exam-count">@Model.Count đề thi</span>
            </div>
        </div>

        <!-- Grid -->
        <div id="exam-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            @foreach (var exam in Model)
            {
                string color = GetDurationColor(exam.DurationMinutes);
                bool isDone = completedIds.Contains(exam.ExerciseId);

                <div class="exam-card fade-up"
                     data-name="@exam.ExerciseName.ToLower()"
                     data-type="@(exam.IsFree ? "free" : "premium")"
                     data-done="@(isDone ? "done" : "not-done")">

                    <!-- Top color bar -->
                    <div style="height:4px; background:@(isDone ? "#22c55e" : color); width:100%;"></div>

                    <div class="p-6 flex flex-col flex-1">
                        <!-- Badge row -->
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                            <span class="text-[10px] font-black px-3 py-1 rounded-full border uppercase tracking-widest"
                                  style="background:@(color)15; color:@color; border-color:@(color)30;">
                                @GetDurationLabel(exam.DurationMinutes)
                            </span>
                            <div class="flex items-center gap-2">
                                @if (isDone)
                                {
                                    <span class="text-[10px] font-black text-green-600 bg-green-50 border border-green-100 px-2.5 py-1 rounded-full flex items-center gap-1">
                                        <i class="fa-solid fa-circle-check text-[9px]"></i> Đã làm
                                    </span>
                                }
                                @if (!exam.IsFree)
                                {
                                    <span class="text-[10px] font-black text-orange-600 bg-orange-50 border border-orange-100 px-2.5 py-1 rounded-full flex items-center gap-1">
                                        <i class="fa-solid fa-crown text-[9px]"></i> Premium
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Title -->
                        <h3 class="font-black text-slate-800 text-lg leading-snug mb-3 flex-1">@exam.ExerciseName</h3>

                        <!-- Meta -->
                        <div class="flex items-center gap-4 text-xs text-slate-400 font-bold mb-5 border-t border-slate-50 pt-4">
                            <span class="flex items-center gap-1.5">
                                <i class="fa-solid fa-circle-question" style="color:@color"></i>
                                @exam.TotalQuestions câu
                            </span>
                            <span class="flex items-center gap-1.5">
                                <i class="fa-regular fa-clock" style="color:@color"></i>
                                @(exam.DurationMinutes ?? 0) phút
                            </span>
                        </div>

                        <!-- CTA -->
                        @{
                            var pkgClaim = User.FindFirst("PackageType")?.Value ?? "0";
                            int userPkg = int.TryParse(pkgClaim, out var pk) ? pk : 0;
                            bool canAccess = exam.IsFree || userPkg >= 2;
                        }

                        @if (canAccess)
                        {
                            <a asp-controller="Exam" asp-action="DoExam" asp-route-id="@exam.ExerciseId"
                               class="w-full py-3 rounded-xl font-black text-xs uppercase tracking-widest transition flex items-center justify-center gap-2"
                               style="@(isDone ? "background:linear-gradient(135deg,#22c55e,#16a34a);color:white;" : !exam.IsFree ? "background:linear-gradient(135deg,#f97316,#ef4444);color:white;" : "border:2px solid #6366f1;color:#6366f1;")">
                                @(isDone ? "Làm lại" : "Thi ngay")
                                <i class="fa-solid @(isDone ? "fa-rotate-right" : "fa-play") text-[10px]"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Package" asp-action="Index"
                               class="w-full py-3 rounded-xl font-black text-xs uppercase tracking-widest text-white flex items-center justify-center gap-2 relative group"
                               style="background:linear-gradient(135deg,#94a3b8,#64748b);">
                                <i class="fa-solid fa-lock text-[10px]"></i> Yêu cầu Premium
                                <span class="absolute -top-9 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-[10px] px-3 py-1 rounded-lg opacity-0 group-hover:opacity-100 transition whitespace-nowrap">
                                    Nâng cấp để mở khóa
                                </span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Empty state -->
        <div id="empty-state" class="hidden py-24 text-center text-slate-300 font-black uppercase text-xs tracking-widest">
            <i class="fa-solid fa-magnifying-glass text-5xl mb-4 block opacity-20"></i>
            Không tìm thấy đề thi phù hợp
        </div>

        <!-- Pagination (chỉ hiện khi > 9 đề) -->
        @if (Model.Count > 9)
        {
            <div id="pagination" class="flex justify-center items-center gap-2 mt-4">
                <button class="page-btn" id="prev-btn" onclick="changePage(-1)" disabled>
                    <i class="fa-solid fa-chevron-left text-[10px]"></i>
                </button>
                <div id="page-numbers" class="flex gap-2"></div>
                <button class="page-btn" id="next-btn" onclick="changePage(1)">
                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
            </div>
        }

    </div>
</section>

<script>
    const ITEMS_PER_PAGE = 9;
    let currentPage = 1;
    let currentFilter = 'all';
    let searchQuery = '';

    const allCards = Array.from(document.querySelectorAll('.exam-card'));

    function getFilteredCards() {
        return allCards.filter(card => {
            const matchFilter = currentFilter === 'all'
                || (currentFilter === 'done' && card.dataset.done === 'done')
                || (currentFilter !== 'done' && card.dataset.type === currentFilter);
            const matchSearch = !searchQuery || card.dataset.name.includes(searchQuery.toLowerCase());
            return matchFilter && matchSearch;
        });
    }

    function render() {
        const filtered = getFilteredCards();
        const total = filtered.length;
        const totalPages = Math.max(1, Math.ceil(total / ITEMS_PER_PAGE));

        if (currentPage > totalPages) currentPage = totalPages;

        const start = (currentPage - 1) * ITEMS_PER_PAGE;
        const end = start + ITEMS_PER_PAGE;

        allCards.forEach(c => c.style.display = 'none');
        filtered.forEach((c, i) => {
            c.style.display = (i >= start && i < end) ? 'flex' : 'none';
        });

        document.getElementById('empty-state').classList.toggle('hidden', total > 0);
        document.getElementById('exam-count').textContent = `${total} đề thi`;

        const pg = document.getElementById('pagination');
        if (!pg) return;

        pg.style.display = totalPages <= 1 ? 'none' : 'flex';

        const container = document.getElementById('page-numbers');
        container.innerHTML = '';
        for (let i = 1; i <= totalPages; i++) {
            const btn = document.createElement('button');
            btn.className = 'page-btn' + (i === currentPage ? ' active' : '');
            btn.textContent = i;
            btn.onclick = () => { currentPage = i; render(); };
            container.appendChild(btn);
        }

        document.getElementById('prev-btn').disabled = currentPage === 1;
        document.getElementById('next-btn').disabled = currentPage === totalPages;
    }

    function changePage(dir) {
        const filtered = getFilteredCards();
        const totalPages = Math.ceil(filtered.length / ITEMS_PER_PAGE);
        currentPage = Math.max(1, Math.min(totalPages, currentPage + dir));
        render();
    }

    function setFilter(f) {
        currentFilter = f;
        currentPage = 1;
        document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.remove('bg-indigo-600', 'text-white', 'bg-green-600');
            b.classList.add('bg-gray-100', 'text-gray-600');
        });
        const active = document.getElementById('filter-' + f);
        active.classList.add('bg-indigo-600', 'text-white');
        active.classList.remove('bg-gray-100', 'text-gray-600');
        render();
    }

    function filterExams() {
        searchQuery = document.getElementById('search-input').value;
        currentPage = 1;
        render();
    }

    render();
</script>
