@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    var invalid = ViewBag.Invalid as bool? ?? false;
    var token = ViewBag.Token as string;
}

<div class="container mx-auto px-4 py-16 flex justify-center">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 p-8">

        @if (invalid)
        {
            <div class="text-center">
                <i class="fa-solid fa-circle-xmark text-red-500 text-5xl"></i>
                <h1 class="mt-4 text-xl font-bold text-red-600">Liên kết không hợp lệ</h1>
                <p class="mt-2 text-sm text-gray-500">Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn.</p>
                <a href="/Account/ForgotPassword"
                   class="inline-block mt-6 px-5 py-2.5 rounded-lg bg-[#1e3a5f] text-white font-semibold hover:bg-[#2a4074]">
                    Yêu cầu liên kết mới
                </a>
            </div>
        }
        else
        {
            <div class="text-center mb-6">
                <i class="fa-solid fa-lock text-blue-500 text-4xl"></i>
                <h1 class="mt-3 text-xl font-bold text-gray-800">Đặt lại mật khẩu</h1>
                <p class="text-sm text-gray-500">Nhập mật khẩu mới cho tài khoản của bạn.</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@token" />

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Mật khẩu mới</label>
                    <input type="password" name="newPassword" required minlength="6"
                           class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none"
                           placeholder="Tối thiểu 6 ký tự" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Xác nhận mật khẩu mới</label>
                    <input type="password" name="confirmPassword" required minlength="6"
                           class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none"
                           placeholder="Nhập lại mật khẩu" />
                </div>
                <button type="submit"
                        class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 text-white font-bold hover:from-blue-700 hover:to-blue-800">
                    Đặt lại mật khẩu
                </button>
            </form>

            <div class="text-center mt-4">
                <a href="/Account/Login" class="text-sm text-gray-500 hover:text-gray-700">← Quay lại đăng nhập</a>
            </div>
        }
    </div>
</div>
