@{
    ViewData["Title"] = "Quên mật khẩu";
    var sent = ViewBag.Sent as bool? ?? false;
}

<div class="container mx-auto px-4 py-16 flex justify-center">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 p-8">

        @if (sent)
        {
            <div class="text-center">
                <i class="fa-solid fa-envelope-circle-check text-green-500 text-5xl"></i>
                <h1 class="mt-4 text-xl font-bold text-gray-800">Kiểm tra hộp thư của bạn</h1>
                <p class="mt-2 text-sm text-gray-500">
                    Nếu <strong>@ViewBag.Email</strong> khớp với một tài khoản đã xác nhận,
                    chúng tôi đã gửi liên kết đặt lại mật khẩu (hết hạn sau 1 giờ).
                </p>
                <a href="/Account/Login"
                   class="inline-block mt-6 px-5 py-2.5 rounded-lg bg-[#1e3a5f] text-white font-semibold hover:bg-[#2a4074]">
                    <i class="fa-solid fa-arrow-left mr-2"></i> Về trang đăng nhập
                </a>
            </div>
        }
        else
        {
            <div class="text-center mb-6">
                <i class="fa-solid fa-key text-blue-500 text-4xl"></i>
                <h1 class="mt-3 text-xl font-bold text-gray-800">Quên mật khẩu?</h1>
                <p class="text-sm text-gray-500">Nhập email đăng ký, chúng tôi sẽ gửi liên kết đặt lại.</p>
            </div>

            <form asp-action="ForgotPassword" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                    <input type="email" name="email" required value="@(ViewBag.Email as string)"
                           class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none"
                           placeholder="email@example.com" />
                </div>
                <button type="submit"
                        class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 text-white font-bold hover:from-blue-700 hover:to-blue-800">
                    Gửi liên kết đặt lại
                </button>
            </form>

            <div class="text-center mt-4">
                <a href="/Account/Login" class="text-sm text-gray-500 hover:text-gray-700">← Quay lại đăng nhập</a>
            </div>
        }
    </div>
</div>
