@{
    ViewData["Title"] = "Liên kết xác thực đã hết hạn";
}

<div class="container mx-auto px-4 py-16 flex justify-center">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 p-8 text-center">
        <div class="mx-auto w-20 h-20 rounded-full bg-amber-100 flex items-center justify-center">
            <i class="fa-solid fa-clock text-amber-500 text-5xl"></i>
        </div>
        <h1 class="mt-5 text-xl font-bold text-amber-600">Liên kết đã hết hạn</h1>
        <p class="mt-2 text-sm text-gray-500">
            Liên kết xác thực email chỉ có hiệu lực trong 24 giờ và đã hết hạn.<br />
            Vui lòng yêu cầu gửi lại email xác thực mới.
        </p>

        <a asp-controller="Account" asp-action="ResendConfirmationEmail"
           class="inline-block mt-6 px-5 py-2.5 rounded-lg bg-amber-500 text-white font-semibold hover:bg-amber-600">
            <i class="fa-solid fa-paper-plane mr-2"></i> Gửi lại email xác thực
        </a>

        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="text-sm text-gray-500 hover:text-blue-600">
                <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>
