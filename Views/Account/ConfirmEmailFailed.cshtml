@{
    ViewData["Title"] = "Xác thực email không thành công";
}

<div class="container mx-auto px-4 py-16 flex justify-center">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 p-8 text-center">
        <div class="mx-auto w-20 h-20 rounded-full bg-red-100 flex items-center justify-center">
            <i class="fa-solid fa-circle-xmark text-red-500 text-5xl"></i>
        </div>
        <h1 class="mt-5 text-xl font-bold text-red-600">Xác thực không thành công</h1>
        <p class="mt-2 text-sm text-gray-500">
            Liên kết xác thực không hợp lệ hoặc đã được sử dụng.<br />
            Vui lòng yêu cầu gửi lại email xác thực.
        </p>

        <a asp-controller="Account" asp-action="ResendConfirmationEmail"
           class="inline-block mt-6 px-5 py-2.5 rounded-lg bg-[#1e3a5f] text-white font-semibold hover:bg-[#2a4074]">
            <i class="fa-solid fa-envelope-circle-check mr-2"></i> Gửi lại email xác thực
        </a>

        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="text-sm text-gray-500 hover:text-blue-600">
                <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>
