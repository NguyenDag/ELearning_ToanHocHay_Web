@{
    ViewData["Title"] = "Gửi lại email xác nhận";
}

<div class="container mx-auto px-4 py-16 flex justify-center">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-100 p-8">
        <div class="text-center mb-6">
            <i class="fa-solid fa-envelope-open-text text-blue-500 text-4xl"></i>
            <h1 class="mt-3 text-xl font-bold text-gray-800">Gửi lại email xác nhận</h1>
            <p class="text-sm text-gray-500">Nhập email đã đăng ký, chúng tôi sẽ gửi lại liên kết xác nhận.</p>
        </div>

        <form asp-controller="Account" asp-action="ResendConfirmationEmail" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                <input type="email" name="email" required autocomplete="email"
                       value="@(ViewBag.Email as string ?? "")"
                       class="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-blue-500 focus:outline-none"
                       placeholder="email@example.com" />
            </div>
            <button type="submit"
                    class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold shadow-lg hover:shadow-xl transition">
                <i class="fa-solid fa-paper-plane mr-2"></i> Gửi email xác nhận
            </button>
        </form>

        <div class="mt-4 rounded-xl bg-blue-50 border border-blue-100 text-blue-700 text-xs px-3 py-2">
            <i class="fa-solid fa-circle-info mr-1"></i>
            <strong>Lưu ý:</strong> hãy kiểm tra cả hộp thư spam nếu bạn không nhận được email.
        </div>

        <div class="text-center mt-4">
            <a asp-controller="Account" asp-action="Login" class="text-sm text-gray-500 hover:text-blue-600">
                <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>
