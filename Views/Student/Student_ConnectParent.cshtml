@* ============================================================
   THÊM VÀO Student/Profile.cshtml
   Đặt sau phần đổi mật khẩu hoặc cuối trang
   ============================================================ *@

@{
    var connectedParents = ViewData["ConnectedParents"] as List<ToanHocHay.WebApp.Controllers.ConnectedParentDto>
                        ?? new List<ToanHocHay.WebApp.Controllers.ConnectedParentDto>();
}

<!-- Kết nối phụ huynh -->
<div class="glass-card p-8 mt-8">
    <div class="flex items-center gap-4 mb-6">
        <div class="w-12 h-12 bg-orange-100 rounded-2xl flex items-center justify-center">
            <i class="fa-solid fa-link text-orange-500 text-lg"></i>
        </div>
        <div>
            <h3 class="font-black text-slate-800">Kết nối với phụ huynh</h3>
            <p class="text-xs text-slate-400 font-bold">Nhập mã phụ huynh để liên kết tài khoản</p>
        </div>
    </div>

    @* Danh sách đã kết nối *@
    @if (connectedParents.Any())
    {
        <div class="mb-6 space-y-3">
            <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Đã kết nối</p>
            @foreach (var p in connectedParents)
            {
                <div class="flex items-center justify-between p-4 bg-green-50 rounded-2xl border border-green-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center font-black text-green-600">
                            @p.FullName.FirstOrDefault()
                        </div>
                        <div>
                            <p class="font-black text-slate-800 text-sm">@p.FullName</p>
                            <p class="text-[10px] text-slate-400 font-bold">@p.Relationship</p>
                        </div>
                    </div>
                    <i class="fa-solid fa-circle-check text-green-500 text-lg"></i>
                </div>
            }
        </div>
    }

    @* Form nhập mã *@
    <div id="connect-parent-form">
        <p class="text-xs text-slate-400 font-bold mb-3">Nhập mã 8 ký tự từ phụ huynh của bạn:</p>
        <div class="flex gap-3">
            <input type="text"
                   id="parent-code-input"
                   maxlength="9"
                   placeholder="Ví dụ: 307C10F6"
                   class="flex-1 px-5 py-3.5 bg-slate-50 border-2 border-slate-200 rounded-2xl font-black text-slate-800 text-center tracking-[.3em] uppercase text-lg focus:outline-none focus:border-indigo-400 transition"
                   oninput="formatParentCode(this)" />
            <button onclick="connectParent()"
                    id="connect-btn"
                    class="px-6 py-3.5 bg-indigo-600 text-white font-black rounded-2xl text-sm hover:bg-indigo-700 transition flex items-center gap-2">
                <i class="fa-solid fa-link"></i>
                Kết nối
            </button>
        </div>

        <!-- Trạng thái -->
        <div id="connect-status" class="mt-3 hidden">
            <div id="connect-success" class="hidden flex items-center gap-2 text-green-600 font-bold text-sm p-3 bg-green-50 rounded-xl">
                <i class="fa-solid fa-circle-check"></i>
                <span id="success-msg">Kết nối thành công!</span>
            </div>
            <div id="connect-error" class="hidden flex items-center gap-2 text-red-500 font-bold text-sm p-3 bg-red-50 rounded-xl">
                <i class="fa-solid fa-circle-xmark"></i>
                <span id="error-msg">Mã không hợp lệ</span>
            </div>
        </div>
    </div>
</div>

<script>
    function formatParentCode(input) {
        // Chỉ cho phép chữ và số, uppercase
        let val = input.value.replace(/[^A-Za-z0-9]/g, '').toUpperCase().slice(0, 8);
        input.value = val;
    }

    async function connectParent() {
        const code = document.getElementById('parent-code-input').value.trim();
        if (code.length !== 8) {
            showConnectError('Mã phải đúng 8 ký tự');
            return;
        }

        const btn = document.getElementById('connect-btn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang kết nối...';

        try {
            const res = await fetch('/Student/ConnectParent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ connectionCode: code })
            });
            const data = await res.json();

            if (res.ok && data.success) {
                showConnectSuccess(data.message || 'Kết nối thành công!');
                document.getElementById('parent-code-input').value = '';
                // Reload sau 1.5s để hiện phụ huynh mới
                setTimeout(() => location.reload(), 1500);
            } else {
                showConnectError(data.message || 'Mã không hợp lệ');
            }
        } catch (e) {
            showConnectError('Lỗi kết nối, vui lòng thử lại');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-link"></i> Kết nối';
        }
    }

    function showConnectSuccess(msg) {
        document.getElementById('connect-status').classList.remove('hidden');
        document.getElementById('connect-success').classList.remove('hidden');
        document.getElementById('connect-error').classList.add('hidden');
        document.getElementById('success-msg').textContent = msg;
    }

    function showConnectError(msg) {
        document.getElementById('connect-status').classList.remove('hidden');
        document.getElementById('connect-error').classList.remove('hidden');
        document.getElementById('connect-success').classList.add('hidden');
        document.getElementById('error-msg').textContent = msg;
    }
</script>
