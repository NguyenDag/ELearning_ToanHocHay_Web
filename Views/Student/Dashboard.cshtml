<script>
    // Progress bar animation
    window.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.progress-fill').forEach(el => {
            const w = el.style.width;
            el.style.width = '0';
            requestAnimationFrame(() => setTimeout(() => { el.style.width = w; }, 100));
        });
    });

    // ── Show more / less chapters ─────────────────────────────────
    let expanded = false;
    function toggleChapters() {
        expanded = !expanded;
        const extras  = document.querySelectorAll('.ch-extra');
        const btnText = document.getElementById('btn-text');
        const btnIcon = document.getElementById('btn-icon');

        extras.forEach((el, i) => {
            if (expanded) {
                el.style.display = 'flex';
                el.style.opacity = '0';
                el.style.transform = 'translateY(10px)';
                el.style.transition = 'opacity .3s ease, transform .3s ease';
                setTimeout(() => { el.style.opacity = ''; el.style.transform = ''; }, i * 60);
            } else {
                el.style.transition = 'none';
                el.style.display = 'none';
            }
        });

        btnText.textContent = expanded ? 'Thu gọn' : `Xem thêm ${extras.length} chương`;
        btnIcon.className   = expanded ? 'fa-solid fa-chevron-up text-[10px]' : 'fa-solid fa-chevron-down text-[10px]';
    }

    // ── Pricing Modal ─────────────────────────────────────────────
    function openPricing() {
        document.getElementById('pricing-modal').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
    function closePricing() {
        document.getElementById('pricing-modal').style.display = 'none';
        document.body.style.overflow = '';
    }

    // Switch tháng / năm
    function switchPricing(mode) {
        const isYear = mode === 'year';
        document.getElementById('pbtn-month').style.color = isYear ? '#94a3b8' : '#1E293B';
        document.getElementById('pbtn-year').style.color  = isYear ? '#1E293B' : '#94a3b8';
        document.getElementById('ptoggle-bg').style.transform = isYear ? 'translateX(100%)' : 'translateX(0)';
        document.querySelectorAll('.price-val').forEach(el => {
            el.textContent = isYear ? el.dataset.year : el.dataset.month;
        });
        document.querySelectorAll('.price-period').forEach(el => {
            el.textContent = isYear ? '/năm' : '/tháng';
        });
    }
</script>
