@using ToanHocHay.WebApp.Models.DTOs
@using System.Security.Claims
@model ToanHocHay.WebApp.Models.DTOs.CoreDashboardDto
@{
    ViewData["Title"] = "Dashboard Học Sinh";
    Layout = "_Layout";

    bool isDbConnected = Model?.StudentInfo != null && Model.StudentInfo.StudentId > 0;

    var sub = Model?.SubscriptionInfo ?? new SubscriptionInfoDto();
    int packageType = sub.PackageType;
    bool isFree = packageType == 0;
    bool isTrial = packageType == 1;
    bool isStandard = packageType >= 2;
    bool isPremium = packageType >= 3;

    bool canChart = isStandard;
    bool canAiHint = isTrial || isStandard;
    bool canUnlimitedHint = isPremium || sub.UnlimitedAiHint;
    bool canPersonalPath = isPremium || sub.PersonalizedPath;
    bool canMistakeRetry = isStandard || sub.MistakeRetry;
    bool canAiAssessment = isPremium;

    string hintDisplay = canUnlimitedHint ? "∞"
                       : canAiHint ? $"0/{sub.AiHintLimitDaily ?? 5}"
                       : "0/0";

    var displayName = isDbConnected ? Model!.StudentInfo.FullName : (User.Identity?.Name ?? "Bạn");
    var firstName = !string.IsNullOrEmpty(displayName) ? displayName.Split(' ').Last() : "Bạn";
    var studentId = User.FindFirst("StudentId")?.Value ?? "N/A";
    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "N/A";
    var httpStatus = Context.Items["LastApiStatus"]?.ToString() ?? "N/A";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>

<style>
    body {
        font-family: 'Nunito', sans-serif;
        background-color: #F4F7FE;
        color: #1E293B;
    }

    .glass-card {
        background: white;
        border-radius: 2rem;
        border: 1px solid #F1F5F9;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        transition: all 0.3s ease;
    }

    .stat-card {
        border-radius: 1.5rem;
        background: white;
        padding: 1.5rem;
        border: 1px solid #F1F5F9;
    }

    .stat-value {
        font-size: 2.25rem;
        font-weight: 900;
        color: #2D3748;
        line-height: 1;
    }

    .stat-label {
        font-size: 0.7rem;
        font-weight: 800;
        color: #A0AEC0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .purple-gradient {
        background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
    }

    .locked-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(8px);
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: inherit;
    }

    .progress-bar {
        height: 10px;
        border-radius: 999px;
        background: #F1F5F9;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 999px;
        background: #6366F1;
        transition: width 1s ease-in-out;
    }

    .debug-box {
        background: #0f172a;
        color: #38bdf8;
        font-family: monospace;
        font-size: 11px;
        border-radius: 1rem;
    }
</style>

<div class="min-h-screen py-8">
    <div class="container mx-auto px-4 max-w-6xl">

        <!-- DEBUG PANEL -->
        @if (!isDbConnected)
        {
            <div class="flex items-center gap-3 bg-amber-50 border border-amber-200 rounded-2xl px-5 py-4 mb-6">
                <i class="fa-solid fa-circle-exclamation text-amber-500 text-lg flex-shrink-0"></i>
                <p class="text-sm font-bold text-amber-700">
                    Không thể tải dữ liệu. Vui lòng
                    <a href="/Account/Logout" class="underline hover:text-amber-900 transition">đăng nhập lại</a> để thử lại.
                </p>
            </div>
        }


        <!-- WELCOME BANNER -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-6">
            <div class="glass-card p-8 flex-1 w-full flex items-center justify-between border-none shadow-sm">
                <div>
                    <h2 class="text-3xl font-black text-slate-800 mb-1">Chào mừng bạn! 👋</h2>
                    <p class="text-slate-400 font-bold">
                        @if (isDbConnected && Model!.Stats.TotalLessonsCompleted > 0)
                        {
                            <span>Bạn đã hoàn thành <b class="text-indigo-600">@Model.Stats.TotalLessonsCompleted</b> bài học.</span>
                        }
                        else
                        {
                            <span>Hãy bắt đầu bài học đầu tiên ngay hôm nay!</span>
                        }
                    </p>
                </div>
            </div>
            <div class="glass-card px-10 py-6 flex items-center gap-5 border-none shadow-orange-100/50">
                <span class="text-4xl">🔥</span>
                <div class="text-left">
                    <p class="stat-label text-orange-400">Streak hiện tại</p>
                    <p class="text-2xl font-black text-orange-600">@(isDbConnected? Model!.Stats.CurrentStreak : 0) Ngày</p>
                </div>
            </div>
        </div>

        <!-- PREMIUM PROMO (chỉ hiện với Free) -->
        @if (isFree || isTrial)
        {
            <div class="purple-gradient rounded-[2.5rem] p-10 mb-10 text-white flex flex-col md:flex-row justify-between items-center gap-8 shadow-2xl shadow-indigo-100 relative overflow-hidden">
                <div class="absolute right-0 top-0 opacity-10 translate-x-1/4 -translate-y-1/4"><i class="fa-solid fa-rocket text-[250px]"></i></div>
                <div class="flex items-center gap-8 relative z-10">
                    <div class="w-20 h-20 bg-white/20 rounded-3xl flex items-center justify-center text-4xl"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                    <div class="text-left">
                        <h3 class="text-3xl font-black mb-2 tracking-tight">Mở khóa sức mạnh AI</h3>
                        <p class="text-indigo-100 font-medium max-w-md">Nâng cấp để sử dụng AI Hint không giới hạn, lộ trình cá nhân hóa và báo cáo phân tích lỗi sai.</p>
                    </div>
                </div>
                <a href="/Package?plan=premium"
                   class="px-10 py-5 bg-white text-indigo-600 font-black rounded-2xl text-xs uppercase shadow-xl hover:scale-105 transition relative z-10">
                    Khám phá gói Premium
                </a>
            </div>
        }

        <!-- STANDARD → PREMIUM PROMO -->
        @if (isStandard && !isPremium)
        {
            <div class="glass-card p-5 mb-8 flex items-center justify-between bg-amber-50/50 border-amber-100">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-amber-100 text-amber-600 rounded-xl flex items-center justify-center"><i class="fa-solid fa-crown"></i></div>
                    <div>
                        <p class="font-black text-amber-800 text-sm">Nâng lên Premium</p>
                        <p class="text-xs text-amber-600">Mở khóa AI Assessment, lộ trình cá nhân hóa và AI Hint không giới hạn.</p>
                    </div>
                </div>
                <a href="/Package?plan=premium"
                   class="px-6 py-3 bg-gradient-to-r from-amber-400 to-orange-500 text-white font-black rounded-xl text-xs uppercase hover:opacity-90 transition">
                    Nâng cấp
                </a>
            </div>
        }

        <!-- QUICK STATS -->

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mb-10">
            <div class="stat-card">
                <p class="stat-label mb-2 text-left">Thời gian học</p>
                <div class="flex items-baseline gap-1">
                    <p class="stat-value text-slate-800">@(isDbConnected ? (Model!.Stats.WeeklyStudyMinutes / 60.0).ToString("F1") : "0")</p>
                    <span class="text-lg font-bold text-slate-300">h</span>
                </div>
                <p class="text-[10px] text-slate-400 font-bold mt-2 text-left uppercase tracking-widest">Tuần này</p>
            </div>
            <div class="stat-card">
                <p class="stat-label mb-2 text-left">Điểm trung bình</p>
                <div class="flex items-baseline gap-1">
                    <p class="stat-value text-indigo-600 text-left">@(isDbConnected? Model!.Stats.AverageScore.ToString("F1") : "0.0")</p>
                    <span class="text-lg font-bold text-slate-300">/10</span>
                </div>
                <p class="text-[10px] text-slate-400 font-bold mt-2 text-left uppercase tracking-widest">
                    @{
                        var avg = isDbConnected ? Model!.Stats.AverageScore : 0;
                        var label = avg >= 8.5 ? "Xuất sắc" : avg >= 7.0 ? "Khá tốt" : avg >= 5.0 ? "Trung bình" : avg > 0 ? "Cần cố gắng" : "Chưa có dữ liệu";
                    }
                    @label
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

            <!-- LEFT CONTENT -->
            <div class="lg:col-span-2 space-y-10">

                <!-- Biểu đồ (locked với Free) -->
                <div class="glass-card p-8 relative overflow-hidden" style="min-height:420px;">
                    @if (!canChart)
                    {
                        <div class="locked-overlay">
                            <div class="w-16 h-16 bg-white rounded-3xl shadow-xl flex items-center justify-center text-indigo-600 mb-6 border border-indigo-50">
                                <i class="fa-solid fa-lock text-3xl"></i>
                            </div>
                            <h4 class="text-2xl font-black text-slate-800 mb-2">Biểu đồ phân tích chuyên sâu</h4>
                            <p class="text-slate-400 font-bold mb-8 text-center max-w-xs">Gói Standard trở lên giúp bạn theo dõi sự tiến bộ qua từng chương.</p>
                            <a href="/Package?plan=standard"
                               class="px-8 py-4 purple-gradient text-white font-black rounded-2xl text-[10px] uppercase shadow-lg shadow-indigo-100">
                                Nâng cấp để xem
                            </a>
                        </div>
                    }

                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h3 class="text-lg font-black text-slate-800">Điểm trung bình theo chương</h3>
                            <p class="text-xs text-slate-400 font-bold mt-0.5">Dựa trên tất cả bài tập đã nộp</p>
                        </div>
                        <div class="flex gap-2">
                            <span class="text-[10px] font-black px-3 py-1.5 bg-indigo-50 text-indigo-600 rounded-lg uppercase tracking-wider">
                                <i class="fa-solid fa-chart-bar mr-1"></i> Standard+
                            </span>
                        </div>
                    </div>

                    <div id="chart-container" style="position:relative; height:300px;">
                        <canvas id="chapterChart"></canvas>
                        <div id="chart-loading" class="absolute inset-0 flex items-center justify-center">
                            <div class="text-center">
                                <i class="fa-solid fa-spinner fa-spin text-indigo-300 text-3xl mb-3"></i>
                                <p class="text-slate-400 font-bold text-sm">Đang tải biểu đồ...</p>
                            </div>
                        </div>
                        <div id="chart-empty" class="hidden absolute inset-0 flex items-center justify-center">
                            <div class="text-center">
                                <i class="fa-solid fa-chart-bar text-slate-200 text-4xl mb-3"></i>
                                <p class="text-slate-400 font-bold text-sm">Chưa có dữ liệu bài tập</p>
                                <p class="text-slate-300 text-xs font-bold mt-1">Hãy làm bài tập để xem biểu đồ</p>
                            </div>
                        </div>
                    </div>

                    <!-- Legend -->
                    <div class="flex items-center gap-6 mt-4 justify-center" id="chart-legend">
                        <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
                            <div class="w-3 h-3 rounded-full bg-indigo-500"></div> Điểm TB (thang 10)
                        </div>
                        <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
                            <div class="w-3 h-3 rounded-full bg-green-400"></div> Đạt (≥ 5)
                        </div>
                        <div class="flex items-center gap-2 text-xs font-bold text-slate-400">
                            <div class="w-3 h-3 rounded-full bg-red-400"></div> Cần cố gắng (< 5)
                        </div>
                    </div>
                </div>

                <!-- Chương trình học -->
                <div class="glass-card p-10">
                    <div class="flex justify-between items-center mb-10">
                        <h3 class="text-2xl font-black text-slate-800 uppercase tracking-tight">Chương trình lớp @(isDbConnected? Model!.StudentInfo.GradeLevel.ToString() : "---")</h3>
                        @if (isDbConnected)
                        {
                            <span class="text-xs text-slate-400 font-bold">@(Model!.ChapterProgress?.Count(c => !c.IsLocked) ?? 0) chương đang mở</span>
                        }
                    </div>

                    <div class="space-y-6" id="chapter-list">
                        @if (isDbConnected && Model!.ChapterProgress != null && Model.ChapterProgress.Any())
                        {
                            var chapters = Model.ChapterProgress.OrderBy(c => c.OrderIndex).ToList();
                            int total = chapters.Count;

                            @for (int i = 0; i < total; i++)
                            {
                                var ch = chapters[i];
                                bool isExtra = i >= 5;
                                <div class="flex items-center gap-8 p-8 @(ch.IsLocked ? "bg-slate-50/50 opacity-60" : "bg-indigo-50/30 border-indigo-100") rounded-[2rem] border transition hover:shadow-md @(isExtra ? "ch-extra" : "")"
                                     style="@(isExtra ? "display:none;" : "")">
                                    <div class="w-16 h-16 @(ch.IsLocked ? "bg-slate-200 text-slate-400" : "bg-indigo-600 text-white shadow-xl shadow-indigo-100") rounded-2xl flex items-center justify-center text-2xl font-black">
                                        @if (ch.IsLocked)
                                        {
                                            <i class="fa-solid fa-lock"></i>
                                        }
                                        else
                                        {

                                            @ch.OrderIndex.ToString("D2")
                                        }
                                    </div>
                                    <div class="flex-1 text-left">
                                        <div class="flex justify-between items-center mb-4">
                                            <h4 class="font-black @(ch.IsLocked ? "text-slate-400" : "text-slate-800") text-xl">@ch.ChapterName</h4>
                                            <span class="font-black text-indigo-600">@ch.CompletionPercentage%</span>
                                        </div>
                                        <div class="progress-bar"><div class="progress-fill" style="width:@ch.CompletionPercentage%"></div></div>
                                        <p class="text-[10px] text-slate-400 font-bold uppercase mt-3 tracking-widest">
                                            @if (ch.IsLocked)
                                            {
                                                <span><i class="fa-solid fa-crown mr-1 text-yellow-500"></i>Yêu cầu gói Premium</span>
                                            }
                                            else
                                            {
                                                <span>Hoàn thành @ch.CompletedTopics / @ch.TotalTopics chủ đề</span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            }

                            @if (total > 5)
                            {
                                <button id="btn-show-more" onclick="toggleChapters()"
                                        class="w-full py-4 rounded-[1.5rem] border-2 border-dashed border-slate-200 text-slate-400 font-black text-xs uppercase tracking-widest hover:border-indigo-300 hover:text-indigo-400 transition flex items-center justify-center gap-2 mt-2">
                                    <i id="btn-icon" class="fa-solid fa-chevron-down text-[10px]"></i>
                                    <span id="btn-text">Xem thêm @(total - 5) chương</span>
                                </button>
                            }
                        }
                        else
                        {
                            <div class="py-20 text-center text-slate-300 italic font-black uppercase text-xs tracking-widest border-2 border-dashed border-slate-100 rounded-[2rem]">
                                <i class="fa-solid fa-book-open text-5xl mb-4 block opacity-10"></i>
                                Chưa có dữ liệu chương trình học
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="space-y-10">

                <!-- Bài tập gần đây -->
                <div class="glass-card p-8">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-10 border-b pb-4 text-left">Bài tập gần đây</h3>
                    <div class="space-y-8">
                        @if (isDbConnected && Model!.RecentLessons != null && Model.RecentLessons.Any())
                        {
                            @foreach (var item in Model.RecentLessons)
                            {
                                <div class="flex flex-col gap-2 p-3 bg-white hover:bg-slate-50 border border-transparent hover:border-slate-100 rounded-2xl transition cursor-pointer relative overflow-hidden">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-4 text-left">
                                            <div class="w-12 h-12 @(item.IsCompleted ? "bg-green-50 text-green-500 border-green-100" : "bg-indigo-50 text-indigo-500 border-indigo-100") rounded-xl flex items-center justify-center shadow-sm border">
                                                <i class="fa-solid @(item.IsCompleted ? "fa-check" : "fa-clock") text-lg"></i>
                                            </div>
                                            <div class="max-w-[150px]">
                                                <p class="font-black text-slate-700 text-sm leading-tight truncate">@item.LessonName</p>
                                                <p class="text-[10px] text-slate-400 font-bold uppercase mt-1 italic">@item.CompletedAt.ToString("dd/MM")</p>
                                            </div>
                                        </div>
                                        <span class="text-sm font-black text-slate-800">
                                            @(item.Score.HasValue? item.Score.Value.ToString("F1") : item.IsCompleted ? "✓" : "---")
                                        </span>
                                    </div>
                                    @if(item.TabSwitchCount > 0)
                                    {
                                        <div class="mt-1 flex items-center gap-2 bg-red-50 text-red-600 text-[11px] font-bold px-3 py-1.5 rounded-lg border border-red-100">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            <span>Nhắc nhở: Chuyển tab @item.TabSwitchCount lần khi làm bài</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="py-16 text-center text-slate-300 italic font-black uppercase text-[10px] tracking-tighter">
                                <i class="fa-solid fa-list-check text-4xl mb-4 block opacity-10"></i>
                                Chưa có hoạt động gần đây
                            </div>
                        }
                    </div>
                </div>

                <!-- AI Assessment (locked nếu chưa Premium) -->
                <div class="glass-card p-8 text-center bg-slate-900 text-white border-none shadow-2xl relative overflow-hidden">
                    <div class="absolute inset-0 purple-gradient opacity-20"></div>
                    @if (!canAiAssessment)
                    {
                        <div class="locked-overlay" style="background:rgba(15,23,42,0.75)">
                            <div class="w-12 h-12 bg-white/10 rounded-2xl flex items-center justify-center text-indigo-400 mb-3">
                                <i class="fa-solid fa-brain text-xl"></i>
                            </div>
                            <p class="font-black text-white text-sm mb-1">AI Assessment</p>
                            <p class="text-slate-400 text-xs mb-4 max-w-[160px]">Phân tích điểm yếu kiến thức. Chỉ dành cho Premium.</p>
                            <a href="/Package?plan=premium"
                               class="px-5 py-2 bg-amber-400 text-slate-900 font-black rounded-xl text-[10px] uppercase">
                                Nâng lên Premium
                            </a>
                        </div>
                    }
                    <div class="relative z-10">
                        <div class="w-16 h-16 bg-white/10 rounded-3xl flex items-center justify-center mx-auto mb-6 text-indigo-400 shadow-inner">
                            <i class="fa-solid fa-brain text-3xl"></i>
                        </div>
                        <p class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.2em] mb-3">AI Assessment</p>
                        @if (canAiAssessment)
                        {
                            <button class="w-full py-4 bg-indigo-600 text-white font-black rounded-2xl text-[10px] uppercase shadow-lg hover:bg-indigo-700 transition">Phân tích ngay</button>
                        }
                    </div>
                </div>

                <!-- Lộ trình học AI (locked nếu chưa Premium) -->
                <div class="glass-card p-8 text-center border-none bg-white shadow-blue-100 relative overflow-hidden">
                    @if (!canPersonalPath)
                    {
                        <div class="locked-overlay">
                            <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-500 mb-3">
                                <i class="fa-solid fa-map-location-dot text-xl"></i>
                            </div>
                            <p class="font-black text-slate-800 text-sm mb-1">Lộ trình cá nhân hóa</p>
                            <p class="text-slate-400 text-xs mb-4 max-w-[180px]">AI sắp xếp bài học theo lỗ hổng kiến thức. Yêu cầu Premium.</p>
                            <a href="/Package?plan=premium"
                               class="px-5 py-2 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-black rounded-xl text-[10px] uppercase">
                                Nâng lên Premium
                            </a>
                        </div>
                    }
                    <h4 class="text-sm font-black text-slate-800 mb-2 uppercase tracking-tighter text-left">Lộ trình học AI</h4>
                    <p class="text-[10px] text-slate-400 font-bold mb-8 italic text-left">Hệ thống tự động sắp xếp bài học dựa trên lỗ hổng kiến thức của bạn.</p>
                    @if (canPersonalPath)
                    {
                        <button class="w-full py-4 border-2 border-indigo-600 text-indigo-600 font-black rounded-2xl text-[10px] uppercase hover:bg-indigo-50 transition">Khám phá ngay</button>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.progress-fill').forEach(el => {
            const w = el.style.width;
            el.style.width = '0';
            requestAnimationFrame(() => setTimeout(() => { el.style.width = w; }, 100));
        });
    });

    let expanded = false;
    function toggleChapters() {
        expanded = !expanded;
        const extras  = document.querySelectorAll('.ch-extra');
        const btnText = document.getElementById('btn-text');
        const btnIcon = document.getElementById('btn-icon');
        extras.forEach((el, i) => {
            if (expanded) {
                el.style.display = 'flex';
                el.style.opacity = '0';
                el.style.transform = 'translateY(10px)';
                el.style.transition = 'opacity .3s ease, transform .3s ease';
                setTimeout(() => { el.style.opacity = ''; el.style.transform = ''; }, i * 60);
            } else {
                el.style.transition = 'none';
                el.style.display = 'none';
            }
        });
        btnText.textContent = expanded ? 'Thu gọn' : `Xem thêm ${extras.length} chương`;
        btnIcon.className   = expanded ? 'fa-solid fa-chevron-up text-[10px]' : 'fa-solid fa-chevron-down text-[10px]';
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    (function() {
        const canChart = @(canChart ? "true" : "false");
        if (!canChart) {
            document.getElementById('chart-loading')?.classList.add('hidden');
            return;
        }

        async function loadChart() {
            try {
                const res  = await fetch('/Dashboard/ChartData');
                const json = await res.json();

                document.getElementById('chart-loading')?.classList.add('hidden');

                if (!json.success || !json.data || json.data.length === 0) {
                    document.getElementById('chart-empty')?.classList.remove('hidden');
                    document.getElementById('chart-legend')?.classList.add('hidden');
                    return;
                }

                const labels = json.data.map(d => {
                    // Rút gọn tên chương nếu quá dài
                    const name = d.chapterName || d.ChapterName || '';
                    return name.length > 20 ? name.substring(0, 18) + '…' : name;
                });
                const scores = json.data.map(d => parseFloat(d.averageScore || d.AverageScore || 0).toFixed(1));
                const colors = scores.map(s => parseFloat(s) >= 5
                    ? 'rgba(99,102,241,0.85)'
                    : 'rgba(239,68,68,0.75)');
                const borderColors = scores.map(s => parseFloat(s) >= 5
                    ? 'rgba(99,102,241,1)'
                    : 'rgba(239,68,68,1)');

                const ctx = document.getElementById('chapterChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels,
                        datasets: [{
                            label: 'Điểm TB',
                            data: scores,
                            backgroundColor: colors,
                            borderColor: borderColors,
                            borderWidth: 2,
                            borderRadius: 10,
                            borderSkipped: false,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: ctx => ` Điểm TB: ${ctx.parsed.y}/10`,
                                    afterLabel: ctx => parseFloat(ctx.parsed.y) >= 5
                                        ? '✅ Đạt yêu cầu' : '⚠️ Cần ôn tập thêm'
                                },
                                backgroundColor: '#1e293b',
                                titleColor: '#94a3b8',
                                bodyColor: '#f1f5f9',
                                padding: 12,
                                cornerRadius: 12,
                            }
                        },
                        scales: {
                            y: {
                                min: 0,
                                max: 10,
                                ticks: {
                                    stepSize: 2,
                                    font: { family: 'Nunito', weight: '700', size: 11 },
                                    color: '#94a3b8',
                                    callback: v => v + ' đ'
                                },
                                grid: { color: '#f1f5f9', lineWidth: 1 },
                                border: { display: false }
                            },
                            x: {
                                ticks: {
                                    font: { family: 'Nunito', weight: '800', size: 10 },
                                    color: '#64748b',
                                    maxRotation: 30,
                                },
                                grid: { display: false },
                                border: { display: false }
                            }
                        },
                        animation: {
                            duration: 800,
                            easing: 'easeOutQuart'
                        }
                    }
                });
            } catch(e) {
                document.getElementById('chart-loading')?.classList.add('hidden');
                document.getElementById('chart-empty')?.classList.remove('hidden');
            }
        }

        loadChart();
    })();
</script>

