@model List<ToanHocHay.WebApp.Models.DTOs.PackageDto>
@{
    ViewData["Title"] = "Chọn gói học";
    Layout = "_Layout";
    var preselected = ViewData["PreselectedPlan"]?.ToString() ?? "";
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>

<style>
    body {
        font-family: 'Nunito', sans-serif;
        background: #F4F7FE;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fade-up {
        animation: fadeUp .5s ease both;
    }

    .d1 {
        animation-delay: .05s;
    }

    .d2 {
        animation-delay: .12s;
    }

    .d3 {
        animation-delay: .19s;
    }

    .d4 {
        animation-delay: .26s;
    }

    .pkg-card {
        background: white;
        border-radius: 2rem;
        border: 2px solid #F1F5F9;
        transition: all .3s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

        .pkg-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 48px rgba(0,0,0,.08);
        }

        .pkg-card.featured {
            border-color: #FB923C;
            box-shadow: 0 16px 40px rgba(249,115,22,.15);
            transform: translateY(-8px);
        }

            .pkg-card.featured:hover {
                transform: translateY(-14px);
            }

    .toggle-pill {
        display: inline-flex;
        background: #F1F5F9;
        border-radius: 999px;
        padding: .25rem;
        position: relative;
    }

        .toggle-pill .bg-slide {
            position: absolute;
            top: .25rem;
            bottom: .25rem;
            left: .25rem;
            width: calc(50% - .25rem);
            background: white;
            border-radius: 999px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            transition: transform .3s ease;
        }

        .toggle-pill button {
            position: relative;
            z-index: 1;
            padding: .45rem 1.75rem;
            border-radius: 999px;
            border: none;
            background: transparent;
            font-family: 'Nunito', sans-serif;
            font-size: .8rem;
            font-weight: 900;
            cursor: pointer;
            transition: color .2s;
        }
</style>

<div class="min-h-screen py-16 px-4">
    <div class="max-w-6xl mx-auto">

        <!-- Header -->
        <div class="text-center mb-12 fade-up d1">
            <span class="inline-block bg-indigo-100 text-indigo-600 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">Bảng giá</span>
            <h1 class="text-4xl md:text-5xl font-black text-slate-800 mb-4 leading-tight">
                Đầu tư cho tương lai<br><span class="text-indigo-600">Toán học của con</span>
            </h1>
            <p class="text-slate-400 font-bold max-w-xl mx-auto">Chọn gói phù hợp để mở khóa <span class="text-indigo-600">AI Tutor</span>, lộ trình cá nhân hóa và biểu đồ phân tích.</p>
        </div>

        <!-- Toggle tháng/năm -->
        <div class="flex justify-center mb-12 fade-up d2">
            <div class="toggle-pill">
                <div class="bg-slide" id="pill-bg"></div>
                <button id="btn-month" onclick="switchMode('month')" style="color:#1E293B">Theo tháng</button>
                <button id="btn-year" onclick="switchMode('year')" style="color:#94a3b8" class="flex items-center gap-2">
                    Theo năm
                    <span style="background:#FEE2E2;color:#ef4444;font-size:.6rem;font-weight:900;padding:.15rem .45rem;border-radius:.4rem;">-30%</span>
                </button>
            </div>
        </div>

        <!-- Cards -->
        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-@(Math.Min(Model.Count + 1, 4)) gap-6 items-start fade-up d3">

                <!-- Free card (luôn hiện) -->
                <div class="pkg-card p-8">
                    <span class="inline-block bg-slate-100 text-slate-500 text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest mb-6">Trải nghiệm</span>
                    <h3 class="text-2xl font-black text-slate-800 mb-1">Miễn phí</h3>
                    <p class="text-sm text-slate-400 font-bold mb-6">Dành cho học sinh muốn làm quen.</p>
                    <div class="mb-8">
                        <span class="text-4xl font-black text-slate-800">0</span>
                        <span class="text-slate-400 font-bold">đ</span>
                    </div>
                    <ul class="space-y-3 mb-8 flex-1">
                        <li class="flex gap-3 text-sm font-bold text-slate-600"><i class="fa-solid fa-check text-green-500 mt-0.5 flex-shrink-0"></i>Học thử 3 bài đầu mỗi chương</li>
                        <li class="flex gap-3 text-sm font-bold text-slate-600"><i class="fa-solid fa-check text-green-500 mt-0.5 flex-shrink-0"></i>Bài tập cơ bản</li>
                    </ul>
                    <a href="@(User.Identity!.IsAuthenticated ? "/Dashboard" : "/Account/Login")"
                       class="block w-full py-3.5 text-center bg-slate-100 text-slate-600 font-black rounded-2xl text-sm uppercase tracking-widest hover:bg-slate-200 transition">
                        @(User.Identity!.IsAuthenticated ? "Đang dùng" : "Bắt đầu miễn phí")
                    </a>
                </div>

                <!-- Dynamic package cards -->
                @foreach (var pkg in Model.Where(p => p.IsActive))
                {
                    bool isFeatured = pkg.PackageName.ToLower().Contains("premium");
                    string accentColor = isFeatured ? "#F97316" : "#6366F1";
                    string accentLight = isFeatured ? "#FFF7ED" : "#EEF2FF";
                    string btnClass = isFeatured
                    ? "background:linear-gradient(135deg,#f97316,#ef4444);color:white;box-shadow:0 8px 24px rgba(249,115,22,.3);"
                    : "background:#6366F1;color:white;box-shadow:0 8px 24px rgba(99,102,241,.2);";

                    <div class="pkg-card @(isFeatured ? "featured" : "") p-8">
                        @if (isFeatured)
                        {
                            <div style="position:absolute;top:0;right:0;background:linear-gradient(135deg,#f97316,#ef4444);color:white;font-size:.6rem;font-weight:900;padding:.35rem .9rem;border-radius:0 2rem 0 .75rem;letter-spacing:.06em;">
                                <i class="fa-solid fa-star mr-1"></i> KHUYÊN DÙNG
                            </div>
                        }
                        <span class="inline-block text-xs font-black px-3 py-1 rounded-full uppercase tracking-widest mb-6"
                              style="background:@accentLight;color:@accentColor;margin-top:@(isFeatured ? ".75rem" : "0")">
                            @(pkg.PackageName.ToLower().Contains("standard") ? "Cơ bản" : pkg.PackageName.ToLower().Contains("premium") ? "Nâng cao" : "Gói học")
                        </span>
                        <h3 class="text-2xl font-black text-slate-800 mb-1">@pkg.PackageName</h3>
                        <p class="text-sm text-slate-400 font-bold mb-6">@(pkg.Description ?? $"{pkg.DurationDays} ngày sử dụng")</p>

                        <!-- Giá -->
                        <div class="mb-8">
                            <span class="price-val text-4xl font-black"
                                  style="color:@accentColor"
                                  data-month="@pkg.Price.ToString("N0")"
                                  data-year="@((pkg.Price * 10 * 0.7m).ToString("N0"))">
                                @pkg.Price.ToString("N0")
                            </span>
                            <span class="price-unit text-slate-400 font-bold">/tháng</span>
                        </div>

                        <!-- Features -->
                        <ul class="space-y-3 mb-8 flex-1">
                            <li class="flex gap-3 text-sm font-bold text-slate-600">
                                <i class="fa-solid fa-check mt-0.5 flex-shrink-0" style="color:@accentColor"></i>
                                Toàn bộ bài giảng & bài tập
                            </li>
                            @if (pkg.UnlimitedAiHint)
                            {
                                <li class="flex gap-3 text-sm font-bold text-slate-600">
                                    <i class="fa-solid fa-check mt-0.5 flex-shrink-0" style="color:@accentColor"></i>
                                    AI Hint không giới hạn
                                </li>
                            }
                            else
                            {
                                <li class="flex gap-3 text-sm font-bold text-slate-600">
                                    <i class="fa-solid fa-check mt-0.5 flex-shrink-0" style="color:@accentColor"></i>
                                    AI Hint (5 lần/ngày)
                                </li>
                            }
                            @if (pkg.PersonalizedPath)
                            {
                                <li class="flex gap-3 text-sm font-bold text-slate-600">
                                    <i class="fa-solid fa-check mt-0.5 flex-shrink-0" style="color:@accentColor"></i>
                                    Lộ trình cá nhân hóa
                                </li>
                            }
                            @if (pkg.MistakeRetry)
                            {
                                <li class="flex gap-3 text-sm font-bold text-slate-600">
                                    <i class="fa-solid fa-check mt-0.5 flex-shrink-0" style="color:@accentColor"></i>
                                    Ôn luyện lỗi sai
                                </li>
                            }
                            @if (pkg.PrioritySupport)
                            {
                                <li class="flex gap-3 text-sm font-bold text-slate-600">
                                    <i class="fa-solid fa-check mt-0.5 flex-shrink-0" style="color:@accentColor"></i>
                                    Hỗ trợ ưu tiên
                                </li>
                            }
                        </ul>

                        <a href="/Package/Checkout/@pkg.PackageId"
                           class="block w-full py-3.5 text-center font-black rounded-2xl text-sm uppercase tracking-widest transition hover:opacity-90 hover:-translate-y-0.5"
                           style="@btnClass">
                            Chọn @pkg.PackageName
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-24 text-slate-300 font-black uppercase tracking-widest">
                <i class="fa-solid fa-box-open text-5xl mb-4 block opacity-20"></i>
                Chưa có gói nào khả dụng
            </div>
        }

        <!-- FAQ nhỏ -->
        <div class="mt-16 text-center fade-up d4">
            <p class="text-sm text-slate-400 font-bold">
                Có thắc mắc? <a href="#" class="text-indigo-600 font-black hover:underline">Xem câu hỏi thường gặp</a>
                &nbsp;hoặc&nbsp;
                <a href="#" class="text-indigo-600 font-black hover:underline">Liên hệ hỗ trợ</a>
            </p>
        </div>

    </div>
</div>

<script>
    let mode = 'month';

    function switchMode(m) {
        mode = m;
        const isYear = m === 'year';
        document.getElementById('pill-bg').style.transform = isYear ? 'translateX(100%)' : 'translateX(0)';
        document.getElementById('btn-month').style.color = isYear ? '#94a3b8' : '#1E293B';
        document.getElementById('btn-year').style.color  = isYear ? '#1E293B' : '#94a3b8';

        document.querySelectorAll('.price-val').forEach(el => {
            el.textContent = isYear ? el.dataset.year : el.dataset.month;
        });
        document.querySelectorAll('.price-unit').forEach(el => {
            el.textContent = isYear ? '/năm' : '/tháng';
        });
    }

    // Preselect nếu có ?plan=premium
    const plan = "@preselected".toLowerCase();
    if (plan.includes('premium') || plan.includes('standard')) {
        // Scroll tới card tương ứng
        window.addEventListener('DOMContentLoaded', () => {
            const cards = document.querySelectorAll('.pkg-card');
            cards.forEach(card => {
                if (card.innerText.toLowerCase().includes(plan)) {
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    card.style.boxShadow = '0 0 0 3px #6366f1, 0 20px 48px rgba(99,102,241,.2)';
                }
            });
        });
    }
</script>
