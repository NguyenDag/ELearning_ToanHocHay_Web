@model ToanHocHay.WebApp.Models.DTOs.PackageDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thanh toán";
    var package = (ToanHocHay.WebApp.Models.DTOs.PackageDto)ViewData["Package"]!;
    var subId = (int)ViewData["SubscriptionId"]!;
    var qrUrl = (string)ViewData["QrUrl"]!;
    var stuName = ViewData["StudentName"]?.ToString() ?? "";
    var stuId = ViewData["StudentId"]?.ToString() ?? "";

    var transferContent = $"TKPTTS SUBSCRIPTION_{subId}";
    var priceRaw = package.Price.ToString("N0");
}

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.tailwindcss.com"></script>

<style>
    body {
        font-family: 'Nunito', sans-serif;
        background: #F4F7FE;
    }

    .glass {
        background: white;
        border-radius: 2rem;
        border: 1px solid #F1F5F9;
        box-shadow: 0 4px 24px rgba(0,0,0,0.05);
    }

    @@keyframes pulse-ring {
        0% {
            transform: scale(1);
            opacity: .6;
        }

        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    @@keyframes check-pop {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        70% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        20%, 60% {
            transform: translateX(-8px);
        }

        40%, 80% {
            transform: translateX(8px);
        }
    }

    @@keyframes confetti-fall {
        0% {
            transform: translateY(-10px) rotate(0deg);
            opacity: 1;
        }

        100% {
            transform: translateY(120px) rotate(720deg);
            opacity: 0;
        }
    }

    .pulse-ring {
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 3px solid #6366f1;
        animation: pulse-ring 1.5s ease-out infinite;
    }

    .check-pop {
        animation: check-pop .5s cubic-bezier(.34,1.56,.64,1) forwards;
    }

    .fade-in-up {
        animation: fadeInUp .4s ease both;
    }

    .shake-anim {
        animation: shake .5s ease;
    }

    .qr-img {
        border-radius: 1.25rem;
        border: 3px solid #E0E7FF;
        padding: 12px;
        background: white;
    }

    .step-dot {
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        font-weight: 900;
        flex-shrink: 0;
    }

    .copy-btn {
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }

        .copy-btn:hover {
            background: #EEF2FF;
            color: #6366f1;
        }

    /* ── Overlays ── */
    .overlay-wrap {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.65);
        backdrop-filter: blur(6px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .overlay-wrap.show {
            display: flex;
        }

    /* Confetti dots */
    .confetti-dot {
        position: absolute;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        animation: confetti-fall 1s ease forwards;
    }
</style>

<!-- ══════════════════════════════════════════
     SUCCESS OVERLAY
══════════════════════════════════════════ -->
<div id="success-overlay" class="overlay-wrap">
    <div id="success-card"
         class="relative bg-white rounded-[2.5rem] p-12 max-w-md w-full mx-4 text-center shadow-2xl fade-in-up overflow-hidden">

        <!-- confetti container -->
        <div id="confetti-box" class="pointer-events-none absolute inset-0"></div>

        <!-- icon -->
        <div class="relative w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-check text-5xl text-green-500 check-pop"></i>
        </div>

        <h2 class="text-3xl font-black text-slate-800 mb-2">Thanh toán thành công!</h2>
        <p class="text-slate-400 font-bold mb-1">
            Gói <span class="text-indigo-600 font-black">@package.PackageName</span> đã được kích hoạt.
        </p>
        <p class="text-xs text-slate-400 font-bold mb-8" id="success-enddate"></p>

        <!-- bouncing dots -->
        <div class="flex justify-center gap-2 mb-8">
            <span class="w-3 h-3 rounded-full bg-indigo-400 animate-bounce" style="animation-delay:0s"></span>
            <span class="w-3 h-3 rounded-full bg-orange-400 animate-bounce" style="animation-delay:.1s"></span>
            <span class="w-3 h-3 rounded-full bg-green-400 animate-bounce" style="animation-delay:.2s"></span>
            <span class="w-3 h-3 rounded-full bg-pink-400 animate-bounce" style="animation-delay:.3s"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400 animate-bounce" style="animation-delay:.4s"></span>
        </div>

        <a href="/Course"
           class="block w-full py-4 bg-indigo-600 text-white font-black rounded-2xl text-sm uppercase tracking-widest hover:bg-indigo-700 transition mb-3">
            Vào học ngay <i class="fa-solid fa-arrow-right ml-2"></i>
        </a>
        <a href="/Package"
           class="block w-full py-3 bg-slate-100 text-slate-500 font-black rounded-2xl text-sm hover:bg-slate-200 transition">
            Xem trang gói học
        </a>
    </div>
</div>

<!-- ══════════════════════════════════════════
     FAILURE / TIMEOUT OVERLAY
══════════════════════════════════════════ -->
<div id="failure-overlay" class="overlay-wrap">
    <div class="bg-white rounded-[2.5rem] p-12 max-w-md w-full mx-4 text-center shadow-2xl fade-in-up">

        <!-- icon -->
        <div class="w-24 h-24 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6" id="fail-icon-wrap">
            <i id="fail-icon" class="fa-solid fa-clock text-5xl text-red-400"></i>
        </div>

        <h2 class="text-3xl font-black text-slate-800 mb-2" id="fail-title">QR đã hết hạn</h2>
        <p class="text-slate-400 font-bold mb-8" id="fail-desc">
            Mã QR đã hết hiệu lực sau 15 phút.<br>Vui lòng tạo đơn mới để thanh toán lại.
        </p>

        <!-- action buttons -->
        <button onclick="retryPayment()"
                class="block w-full py-4 bg-indigo-600 text-white font-black rounded-2xl text-sm uppercase tracking-widest hover:bg-indigo-700 transition mb-3">
            <i class="fa-solid fa-rotate-right mr-2"></i> Tạo đơn mới
        </button>
        <a href="/Home/Contact"
           class="block w-full py-3 bg-slate-100 text-slate-500 font-black rounded-2xl text-sm hover:bg-slate-200 transition">
            <i class="fa-solid fa-headset mr-2"></i> Liên hệ hỗ trợ
        </a>

        <!-- already paid? -->
        <p class="text-xs text-slate-400 font-bold mt-6">
            Đã chuyển khoản nhưng chưa kích hoạt?
            <a href="/Home/Contact" class="text-indigo-500 hover:underline">Báo ngay để được xử lý</a>
        </p>
    </div>
</div>

<!-- ══════════════════════════════════════════
     PAGE BODY
══════════════════════════════════════════ -->
<div class="min-h-screen py-10 px-4">
    <div class="max-w-5xl mx-auto">

        <div class="text-center mb-10">
            <h1 class="text-3xl font-black text-slate-800 mb-2">Thanh toán đơn hàng</h1>
            <p class="text-slate-400 font-bold">
                Quét mã QR để kích hoạt gói <span class="text-indigo-600">@package.PackageName</span>
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

            <!-- ── LEFT ── -->
            <div class="space-y-6">

                <!-- QR Card -->
                <div class="glass p-8 flex flex-col items-center">
                    <div id="status-badge"
                         class="flex items-center gap-2 px-4 py-2 bg-amber-50 border border-amber-200 rounded-full mb-6">
                        <div class="relative w-4 h-4 flex-shrink-0">
                            <div class="pulse-ring"></div>
                            <div class="w-4 h-4 rounded-full bg-amber-400"></div>
                        </div>
                        <span class="text-xs font-black text-amber-700 uppercase tracking-widest">Chờ thanh toán...</span>
                    </div>

                    <div id="qr-section" class="text-center">
                        <img src="@qrUrl" alt="QR Thanh toán"
                             class="qr-img w-64 h-64 object-contain mx-auto mb-4" />
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mb-1">Mã QR hết hạn sau</p>
                        <p class="text-2xl font-black text-indigo-600" id="countdown">15:00</p>
                    </div>
                </div>

                <!-- Bank Info -->
                <div class="glass p-6">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-5 border-b pb-3 flex items-center gap-2">
                        <i class="fa-solid fa-building-columns text-indigo-400"></i>
                        Thông tin chuyển khoản
                    </h3>
                    <div class="space-y-3">
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl">
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Ngân hàng</p>
                                <p class="font-black text-slate-800">TPBank (Tiên Phong)</p>
                            </div>
                            <img src="https://api.vietqr.io/img/TPB.png" alt="TPBank" class="h-8 w-auto" onerror="this.style.display='none'" />
                        </div>

                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl gap-3">
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Số tài khoản</p>
                                <p class="font-black text-slate-800 text-lg tracking-wider">00000802110</p>
                            </div>
                            <button onclick="copyById('v-stk',this)"
                                    class="copy-btn px-3 py-1.5 bg-slate-100 rounded-xl text-xs font-black text-slate-500 flex items-center gap-1.5 flex-shrink-0">
                                <i class="fa-regular fa-copy"></i> Sao chép
                            </button>
                            <span id="v-stk" class="sr-only">00000802110</span>
                        </div>

                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl gap-3">
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Chủ tài khoản</p>
                                <p class="font-black text-slate-800">NGUYEN DANG NGUYEN</p>
                            </div>
                            <button onclick="copyById('v-name',this)"
                                    class="copy-btn px-3 py-1.5 bg-slate-100 rounded-xl text-xs font-black text-slate-500 flex items-center gap-1.5 flex-shrink-0">
                                <i class="fa-regular fa-copy"></i> Sao chép
                            </button>
                            <span id="v-name" class="sr-only">NGUYEN DANG NGUYEN</span>
                        </div>

                        <div class="flex items-center justify-between p-3 bg-indigo-50 rounded-xl border border-indigo-100 gap-3">
                            <div>
                                <p class="text-[10px] font-black text-indigo-400 uppercase tracking-widest">Số tiền</p>
                                <p class="font-black text-indigo-700 text-lg">@priceRaw đ</p>
                            </div>
                            <button onclick="copyById('v-amount',this)"
                                    class="copy-btn px-3 py-1.5 bg-indigo-100 rounded-xl text-xs font-black text-indigo-500 flex items-center gap-1.5 flex-shrink-0">
                                <i class="fa-regular fa-copy"></i> Sao chép
                            </button>
                            <span id="v-amount" class="sr-only">@((long)package.Price)</span>
                        </div>

                        <div class="flex items-center justify-between p-4 bg-amber-50 rounded-xl border-2 border-amber-200 gap-3">
                            <div class="min-w-0">
                                <p class="text-[10px] font-black text-amber-500 uppercase tracking-widest flex items-center gap-1 mb-1">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Nội dung CK (bắt buộc)
                                </p>
                                <p class="font-black text-amber-800 text-base tracking-wide break-all">@transferContent</p>
                            </div>
                            <button onclick="copyById('v-content',this)"
                                    class="copy-btn px-3 py-1.5 bg-amber-100 rounded-xl text-xs font-black text-amber-600 flex items-center gap-1.5 flex-shrink-0">
                                <i class="fa-regular fa-copy"></i> Sao chép
                            </button>
                            <span id="v-content" class="sr-only">@transferContent</span>
                        </div>
                    </div>
                    <p class="text-[10px] text-red-500 font-black mt-4 flex items-start gap-1.5">
                        <i class="fa-solid fa-circle-info mt-0.5 flex-shrink-0"></i>
                        Nhập đúng nội dung <b>@transferContent</b> để hệ thống tự động kích hoạt gói.
                    </p>
                </div>

                <!-- Steps -->
                <div class="glass p-6">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-4">Hướng dẫn thanh toán</h3>
                    <div class="space-y-3">
                        @{
                            var steps = new[] {
                                                ("1","Mở app ngân hàng bất kỳ","fa-mobile-screen"),
                                                ("2","Chọn QR Pay / Quét mã QR","fa-qrcode"),
                                                ("3","Quét mã QR hoặc nhập STK thủ công","fa-camera"),
                                                ("4","Nhập đúng nội dung chuyển khoản","fa-file-lines"),
                                                ("5","Xác nhận & hoàn tất thanh toán","fa-check-double"),
                                                };
                        }
                        @foreach (var (num, text, icon) in steps)
                        {
                            <div class="flex items-center gap-3">
                                <div class="step-dot bg-indigo-100 text-indigo-600">@num</div>
                                <div class="flex items-center gap-2 text-sm font-bold text-slate-600">
                                    <i class="fa-solid @icon text-indigo-400 w-4 text-center"></i>
                                    @text
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ── RIGHT ── -->
            <div class="space-y-6">
                <div class="glass p-8">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6 border-b pb-4">Chi tiết đơn hàng</h3>
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-14 h-14 bg-indigo-100 rounded-2xl flex items-center justify-center text-2xl">
                            @(package.PackageName.Contains("Premium") ? "⭐" : "🎯")
                        </div>
                        <div>
                            <p class="font-black text-slate-800 text-lg">@package.PackageName</p>
                            <p class="text-sm text-slate-400 font-bold">@package.DurationDays ngày sử dụng</p>
                        </div>
                    </div>
                    <div class="space-y-2 mb-6">
                        <div class="flex items-center gap-2 text-sm font-bold text-slate-600">
                            <i class="fa-solid fa-check text-green-500"></i> Toàn bộ bài giảng & bài tập
                        </div>
                        @if (package.UnlimitedAiHint)
                        {
                            <div class="flex items-center gap-2 text-sm font-bold text-slate-600"><i class="fa-solid fa-check text-green-500"></i> AI Hint không giới hạn</div>
                        }
                        else
                        {
                            <div class="flex items-center gap-2 text-sm font-bold text-slate-600"><i class="fa-solid fa-check text-green-500"></i> AI Hint (5 lần/ngày)</div>
                        }
                        @if (package.PersonalizedPath)
                        {
                            <div class="flex items-center gap-2 text-sm font-bold text-slate-600"><i class="fa-solid fa-check text-green-500"></i> Lộ trình cá nhân hóa</div>
                        }
                        @if (package.MistakeRetry)
                        {
                            <div class="flex items-center gap-2 text-sm font-bold text-slate-600"><i class="fa-solid fa-check text-green-500"></i> Ôn luyện lỗi sai</div>
                        }
                        @if (package.PrioritySupport)
                        {
                            <div class="flex items-center gap-2 text-sm font-bold text-slate-600"><i class="fa-solid fa-check text-green-500"></i> Hỗ trợ ưu tiên</div>
                        }
                    </div>
                    <div class="border-t pt-4 space-y-2">
                        <div class="flex justify-between text-sm font-bold text-slate-500">
                            <span>Giá gói</span><span>@priceRaw đ</span>
                        </div>
                        <div class="flex justify-between text-sm font-bold text-slate-500">
                            <span>Giảm giá</span><span class="text-green-500">0 đ</span>
                        </div>
                        <div class="flex justify-between font-black text-slate-800 text-xl pt-2 border-t">
                            <span>Tổng thanh toán</span>
                            <span class="text-indigo-600">@priceRaw đ</span>
                        </div>
                    </div>
                </div>

                <div class="glass p-6 space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-1">Mã đơn hàng</p>
                            <p class="font-black text-slate-800 text-lg">#SUB-@subId.ToString("D6")</p>
                        </div>
                        <div class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-slate-400">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(stuName))
                    {
                        <div class="border-t pt-4 space-y-2">
                            <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Thông tin học sinh</p>
                            <div class="flex justify-between text-sm font-bold text-slate-600">
                                <span>Họ tên</span><span class="text-slate-800">@stuName</span>
                            </div>
                            <div class="flex justify-between text-sm font-bold text-slate-600">
                                <span>Mã học sinh</span><span class="text-slate-800">#@stuId</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="glass p-6 border border-blue-100">
                    <div class="flex gap-3">
                        <i class="fa-solid fa-circle-info text-blue-400 mt-0.5 flex-shrink-0"></i>
                        <div class="text-sm text-slate-500 font-bold space-y-1">
                            <p>Gói được kích hoạt <b class="text-slate-700">ngay sau khi thanh toán thành công</b>.</p>
                            <p>Nhập đúng nội dung <b class="text-amber-600">@transferContent</b> để hệ thống nhận diện tự động.</p>
                            <p>Nếu chưa kích hoạt sau 5 phút, vui lòng <a href="/Home/Contact" class="text-indigo-600 hover:underline">liên hệ hỗ trợ</a>.</p>
                        </div>
                    </div>
                </div>

                <a href="/Package" class="block text-center text-sm text-slate-400 font-bold hover:text-slate-600 transition py-2">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại chọn gói khác
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Config ──────────────────────────────────────────────
        const SUBSCRIPTION_ID = @subId;
        const API_STATUS_URL  = `/Package/CheckStatus?subscriptionId=${SUBSCRIPTION_ID}`;
        const POLL_INTERVAL_MS   = 3000;   // 3 giây
        const QR_TIMEOUT_SECONDS = 15 * 60; // 15 phút

        // ── State ────────────────────────────────────────────────
        let pollInterval;
        let countdownSeconds = QR_TIMEOUT_SECONDS;
        let isFinished = false;

        // ── Elements ─────────────────────────────────────────────
        const countdownEl  = document.getElementById('countdown');
        const statusBadge  = document.getElementById('status-badge');

        // ── Countdown ────────────────────────────────────────────
        const countdownTimer = setInterval(() => {
            if (isFinished) return clearInterval(countdownTimer);

            countdownSeconds--;

            if (countdownSeconds <= 0) {
                clearInterval(countdownTimer);
                stopPolling();
                showFailure('timeout');
                return;
            }

            // Warning colour when < 2 min
            if (countdownSeconds < 120) {
                countdownEl.classList.remove('text-indigo-600');
                countdownEl.classList.add('text-red-500');
            }

            const m = Math.floor(countdownSeconds / 60);
            const s = countdownSeconds % 60;
            countdownEl.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
        }, 1000);

        // ── Polling ───────────────────────────────────────────────
        async function checkPaymentStatus() {
            if (isFinished) return;
            try {
                const res = await fetch(API_STATUS_URL);
                if (!res.ok) return; // Bỏ qua lỗi mạng tạm thời

                const data = await res.json();

                switch (data.status) {
                    case 'Active':
                        stopPolling();
                        showSuccess(data.endDate);
                        break;

                    case 'Expired':
                        stopPolling();
                        showFailure('expired');
                        break;

                    case 'Cancelled':
                        stopPolling();
                        showFailure('cancelled');
                        break;

                    case 'Pending':
                    default:
                        // Vẫn đang chờ → tiếp tục poll
                        break;
                }
            } catch (e) {
                console.warn('Poll error:', e);
            }
        }

        function stopPolling() {
            isFinished = true;
            clearInterval(pollInterval);
            clearInterval(countdownTimer);
        }

        // Bắt đầu poll ngay sau 2s, rồi mỗi 3s
        setTimeout(checkPaymentStatus, 2000);
        pollInterval = setInterval(checkPaymentStatus, POLL_INTERVAL_MS);

        // ── Show Success ──────────────────────────────────────────
        function showSuccess(endDate) {
            // Update badge
            statusBadge.className = 'flex items-center gap-2 px-4 py-2 bg-green-50 border border-green-200 rounded-full mb-6';
            statusBadge.innerHTML = `
                <i class="fa-solid fa-check text-green-500"></i>
                <span class="text-xs font-black text-green-700 uppercase tracking-widest">Đã thanh toán!</span>`;

            // End date
            if (endDate) {
                const d = new Date(endDate);
                document.getElementById('success-enddate').textContent =
                    `Hạn sử dụng: ${d.toLocaleDateString('vi-VN')}`;
            }

            // Confetti burst
            spawnConfetti();

            // Show overlay
            document.getElementById('success-overlay').classList.add('show');
        }

        function showFailure(reason) {
            const iconWrap = document.getElementById('fail-icon-wrap');
            const icon     = document.getElementById('fail-icon');
            const title    = document.getElementById('fail-title');
            const desc     = document.getElementById('fail-desc');

            const configs = {
                timeout: {
                    iconClass: 'fa-solid fa-clock text-5xl text-orange-400 check-pop',
                    bgClass:   'bg-orange-100',
                    title:     'QR đã hết hạn',
                    desc:      'Mã QR đã hết hiệu lực sau 15 phút.<br>Vui lòng tạo đơn mới để thanh toán lại.',
                    badgeText: 'QR đã hết hạn',
                    badgeCls:  'flex items-center gap-2 px-4 py-2 bg-orange-50 border border-orange-200 rounded-full mb-6',
                    badgeIcon: 'fa-solid fa-clock text-orange-400',
                    badgeTxtCls: 'text-xs font-black text-orange-600 uppercase tracking-widest',
                },
                expired: {
                    iconClass: 'fa-solid fa-calendar-xmark text-5xl text-red-400 check-pop',
                    bgClass:   'bg-red-100',
                    title:     'Đơn hàng đã hết hạn',
                    desc:      'Đơn hàng này đã hết thời hạn thanh toán.<br>Vui lòng tạo đơn mới để tiếp tục.',
                    badgeText: 'Đơn hết hạn',
                    badgeCls:  'flex items-center gap-2 px-4 py-2 bg-red-50 border border-red-200 rounded-full mb-6',
                    badgeIcon: 'fa-solid fa-calendar-xmark text-red-400',
                    badgeTxtCls: 'text-xs font-black text-red-600 uppercase tracking-widest',
                },
                cancelled: {
                    iconClass: 'fa-solid fa-ban text-5xl text-slate-400 check-pop',
                    bgClass:   'bg-slate-100',
                    title:     'Đơn hàng đã bị huỷ',
                    desc:      'Đơn hàng này đã bị huỷ và không thể thanh toán.<br>Vui lòng tạo đơn mới nếu bạn muốn tiếp tục.',
                    badgeText: 'Đã huỷ đơn',
                    badgeCls:  'flex items-center gap-2 px-4 py-2 bg-slate-100 border border-slate-300 rounded-full mb-6',
                    badgeIcon: 'fa-solid fa-ban text-slate-400',
                    badgeTxtCls: 'text-xs font-black text-slate-500 uppercase tracking-widest',
                },
            };

            const cfg = configs[reason] ?? configs['timeout'];

            icon.className     = cfg.iconClass;
            iconWrap.className = `w-24 h-24 ${cfg.bgClass} rounded-full flex items-center justify-center mx-auto mb-6`;
            title.textContent  = cfg.title;
            desc.innerHTML     = cfg.desc;

            // Update status badge trên QR card
            statusBadge.className = cfg.badgeCls;
            statusBadge.innerHTML = `
                <i class="${cfg.badgeIcon}"></i>
                <span class="${cfg.badgeTxtCls}">${cfg.badgeText}</span>`;

            // Update countdown text
            countdownEl.textContent = 'Hết hạn';
            countdownEl.classList.remove('text-indigo-600');
            countdownEl.classList.add('text-red-500');

            document.getElementById('failure-overlay').classList.add('show');
        }

        // ── Retry: back to package page ───────────────────────────
        function retryPayment() {
            window.location.href = '/Package';
        }

        // ── Confetti ──────────────────────────────────────────────
        function spawnConfetti() {
            const box    = document.getElementById('confetti-box');
            const colors = ['#6366f1','#f97316','#22c55e','#ec4899','#eab308','#06b6d4'];
            for (let i = 0; i < 30; i++) {
                const dot = document.createElement('div');
                dot.className = 'confetti-dot';
                dot.style.left            = `${Math.random() * 100}%`;
                dot.style.top             = `${Math.random() * 30}%`;
                dot.style.background      = colors[Math.floor(Math.random() * colors.length)];
                dot.style.animationDelay  = `${Math.random() * 0.6}s`;
                dot.style.animationDuration = `${0.8 + Math.random() * 0.6}s`;
                box.appendChild(dot);
            }
        }

        // ── Copy helper ───────────────────────────────────────────
        function copyById(spanId, btn) {
            const text = document.getElementById(spanId)?.textContent?.trim() ?? '';
            navigator.clipboard.writeText(text).then(() => {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Đã sao chép';
                btn.classList.add('bg-green-100','text-green-600');
                setTimeout(() => {
                    btn.innerHTML = orig;
                    btn.classList.remove('bg-green-100','text-green-600');
                }, 2000);
            });
        }
    </script>
}
