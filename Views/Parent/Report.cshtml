@* FILE: Views/Parent/Report.cshtml *@
@{
    Layout = null;
    var parentName = ViewData["ParentName"]?.ToString() ?? User.Identity?.Name ?? "Phụ huynh";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Báo cáo học tập - ToanHocHay</title>
    <link rel="icon" type="image/x-icon" href="/logo_header.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: #F4F7FE;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-up {
            animation: fadeUp .4s ease both;
        }

        .d1 {
            animation-delay: .05s
        }

        .d2 {
            animation-delay: .1s
        }

        .d3 {
            animation-delay: .15s
        }

        .d4 {
            animation-delay: .2s
        }

        .glass {
            background: white;
            border-radius: 1.5rem;
            border: 1px solid #F1F5F9;
            box-shadow: 0 4px 20px rgba(0,0,0,.04);
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .75rem 1rem;
            border-radius: .75rem;
            color: #64748b;
            font-weight: 700;
            font-size: .875rem;
            transition: all .2s;
            text-decoration: none;
        }

            .sidebar-link:hover {
                background: #F1F5F9;
                color: #4f46e5;
                transform: translateX(3px);
            }

            .sidebar-link.active {
                background: #EEF2FF;
                color: #4f46e5;
            }

        .stat-card {
            background: white;
            border-radius: 1.25rem;
            padding: 1.25rem;
            border: 1px solid #F1F5F9;
            box-shadow: 0 4px 16px rgba(0,0,0,.04);
            transition: all .3s;
        }

            .stat-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(0,0,0,.08);
            }

        .progress-bar {
            height: 8px;
            border-radius: 99px;
            background: #F1F5F9;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 99px;
            transition: width 1s ease;
        }

        .child-tab {
            padding: .5rem 1.25rem;
            border-radius: .75rem;
            font-weight: 800;
            font-size: .875rem;
            cursor: pointer;
            transition: all .2s;
            border: 2px solid transparent;
        }

            .child-tab.active {
                background: #EEF2FF;
                color: #4f46e5;
                border-color: #c7d2fe;
            }

            .child-tab:not(.active) {
                color: #64748b;
            }

                .child-tab:not(.active):hover {
                    background: #F8FAFF;
                    color: #4f46e5;
                }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="hidden lg:flex flex-col w-64 bg-white border-r border-gray-100 p-4 shadow-sm">
            <div class="flex items-center gap-2 px-2 mb-8 mt-2">
                <img src="/logo_header.ico" class="w-8 h-8 object-contain">
                <span class="font-black text-lg bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">ToanHocHay</span>
            </div>
            <div class="flex items-center gap-3 px-2 mb-6 pb-6 border-b border-gray-100">
                <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-pink-500 rounded-2xl flex items-center justify-center text-white font-black text-lg shadow-md">
                    @parentName.FirstOrDefault()
                </div>
                <div>
                    <p class="font-black text-slate-800 text-sm leading-tight">@parentName</p>
                    <span class="text-[10px] bg-orange-100 text-orange-600 font-black px-2 py-0.5 rounded-full uppercase">Phụ huynh</span>
                </div>
            </div>
            <nav class="space-y-1 flex-1">
                <a href="/Parent/Dashboard" class="sidebar-link">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i> Tổng quan
                </a>
                <a href="/Parent/Connection" class="sidebar-link">
                    <i class="fa-solid fa-link w-5 text-center"></i> Mã kết nối
                </a>
                <a href="/Parent/Report" class="sidebar-link active">
                    <i class="fa-solid fa-chart-line w-5 text-center text-indigo-500"></i> Báo cáo học tập
                </a>
            </nav>
            <div class="border-t border-gray-100 pt-4 mt-4">
                <a href="/Account/Logout" class="sidebar-link text-red-500 hover:bg-red-50 hover:text-red-600">
                    <i class="fa-solid fa-right-from-bracket w-5 text-center"></i> Đăng xuất
                </a>
            </div>
        </aside>

        <!-- Main -->
        <main class="flex-1 p-6 lg:p-8 overflow-auto">

            <!-- Mobile header -->
            <div class="flex items-center justify-between mb-6 lg:hidden">
                <div class="flex items-center gap-2">
                    <img src="/logo_header.ico" class="w-7 h-7">
                    <span class="font-black text-indigo-700">ToanHocHay</span>
                </div>
                <a href="/Account/Logout" class="text-red-400 hover:text-red-600">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>

            <!-- Page title -->
            <div class="mb-6 fade-up d1">
                <h1 class="text-2xl font-black text-slate-800 mb-1">Báo cáo học tập 📊</h1>
                <p class="text-slate-400 font-bold text-sm">Theo dõi chi tiết tiến trình học của con</p>
            </div>

            <!-- Child tabs -->
            <div id="child-tabs" class="flex gap-2 mb-6 fade-up d1 flex-wrap">
                <div class="text-slate-400 font-bold text-sm flex items-center gap-2">
                    <i class="fa-solid fa-spinner fa-spin"></i> Đang tải...
                </div>
            </div>

            <!-- Report content -->
            <div id="report-content">
                <!-- Loading skeleton -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="stat-card animate-pulse">
                            <div class="h-4 bg-slate-100 rounded mb-3 w-2/3"></div>
                            <div class="h-8 bg-slate-100 rounded mb-2 w-1/2"></div>
                            <div class="h-3 bg-slate-100 rounded w-3/4"></div>
                        </div>
                    }
                </div>
            </div>

            <!-- No children state -->
            <div id="no-children" class="hidden">
                <div class="glass p-16 text-center fade-up">
                    <div class="w-20 h-20 bg-slate-100 rounded-3xl flex items-center justify-center mx-auto mb-5">
                        <i class="fa-solid fa-user-plus text-slate-300 text-3xl"></i>
                    </div>
                    <p class="font-black text-slate-500 text-lg mb-2">Chưa có học sinh nào kết nối</p>
                    <p class="text-slate-400 font-bold text-sm mb-5">Chia sẻ mã kết nối cho con để xem báo cáo</p>
                    <a href="/Parent/Connection"
                       class="inline-block px-6 py-3 bg-indigo-600 text-white font-black rounded-xl hover:bg-indigo-700 transition text-sm">
                        <i class="fa-solid fa-link mr-2"></i> Xem mã kết nối
                    </a>
                </div>
            </div>

        </main>
    </div>

    <script>
        let children = [];
        let currentStudentId = null;

        async function init() {
            try {
                const res  = await fetch('/Parent/GetInfo');
                const data = await res.json();

                if (!data.children || data.children.length === 0) {
                    document.getElementById('child-tabs').classList.add('hidden');
                    document.getElementById('report-content').classList.add('hidden');
                    document.getElementById('no-children').classList.remove('hidden');
                    return;
                }

                children = data.children;
                renderTabs(children);
                loadReport(children[0].studentId || children[0].StudentId);
            } catch {
                document.getElementById('child-tabs').innerHTML =
                    '<p class="text-red-400 font-bold text-sm">Lỗi tải dữ liệu</p>';
            }
        }

        function renderTabs(children) {
            const tabs = document.getElementById('child-tabs');
            tabs.innerHTML = children.map((c, i) => `
                <button onclick="loadReport(${c.studentId || c.StudentId}, this)"
                        class="child-tab ${i === 0 ? 'active' : ''}">
                    <i class="fa-solid fa-child mr-1.5 text-xs"></i>
                    ${c.fullName || c.FullName}
                </button>`).join('');
        }

        async function loadReport(studentId, tabBtn) {
            currentStudentId = studentId;

            // Update active tab
            if (tabBtn) {
                document.querySelectorAll('.child-tab').forEach(t => t.classList.remove('active'));
                tabBtn.classList.add('active');
            }

            // Show loading
            document.getElementById('report-content').innerHTML = `
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                    ${[0,1,2,3].map(() => `
                        <div class="stat-card animate-pulse">
                            <div class="h-4 bg-slate-100 rounded mb-3 w-2/3"></div>
                            <div class="h-8 bg-slate-100 rounded mb-2 w-1/2"></div>
                            <div class="h-3 bg-slate-100 rounded w-3/4"></div>
                        </div>`).join('')}
                </div>`;

            try {
                const res  = await fetch(`/Parent/GetStudentReport?studentId=${studentId}`);
                const data = await res.json();
                if (data.success) {
                    renderReport(data.data);
                } else {
                    showError(data.message || 'Không tải được báo cáo');
                }
            } catch {
                showError('Lỗi kết nối');
            }
        }

                function renderReport(d) {
            // BE trả về PascalCase
            const stats    = d.Stats    || d.stats    || {};
            const info     = d.StudentInfo || d.studentInfo || {};
            const chapters = d.ChapterProgress || d.chapterProgress || [];
            const lessons  = d.RecentLessons  || d.recentLessons  || [];

            const avgScore = stats.AverageScore ?? stats.averageScore ?? 0;
            const scoreColor = avgScore >= 8 ? 'text-green-600' :
                               avgScore >= 5 ? 'text-amber-500' : 'text-red-500';

            document.getElementById('report-content').innerHTML = `
                <div class="glass p-5 mb-6 flex items-center gap-4 fade-up">
                    <div class="w-14 h-14 bg-gradient-to-br from-indigo-400 to-purple-500 rounded-2xl flex items-center justify-center text-white font-black text-xl shadow-md">
                        ${(info.FullName || info.fullName || '?')[0]}
                    </div>
                    <div>
                        <p class="font-black text-slate-800 text-lg">${info.FullName || info.fullName || 'Học sinh'}</p>
                        <p class="text-slate-400 font-bold text-sm">Lớp ${info.GradeLevel || info.gradeLevel || 6} · ${info.SchoolName || info.schoolName || 'Chưa có trường'}</p>
                    </div>
                    <div class="ml-auto flex items-center gap-2">
                        <div class="px-4 py-2 bg-orange-100 rounded-xl text-center">
                            <p class="text-xl font-black text-orange-600">🔥 ${stats.CurrentStreak ?? stats.currentStreak ?? 0}</p>
                            <p class="text-[10px] font-black text-slate-400 uppercase">Streak</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6 fade-up">
                    <div class="stat-card text-center">
                        <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-2">
                            <i class="fa-solid fa-clock text-blue-600"></i>
                        </div>
                        <p class="text-2xl font-black text-slate-800">${stats.WeeklyStudyMinutes ?? stats.weeklyStudyMinutes ?? 0}</p>
                        <p class="text-xs text-slate-400 font-bold">phút học tuần này</p>
                    </div>
                    <div class="stat-card text-center">
                        <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center mx-auto mb-2">
                            <i class="fa-solid fa-star text-green-600"></i>
                        </div>
                        <p class="text-2xl font-black ${scoreColor}">${avgScore}/10</p>
                        <p class="text-xs text-slate-400 font-bold">điểm trung bình</p>
                    </div>
                    <div class="stat-card text-center">
                        <div class="w-10 h-10 bg-purple-100 rounded-xl flex items-center justify-center mx-auto mb-2">
                            <i class="fa-solid fa-pen-to-square text-purple-600"></i>
                        </div>
                        <p class="text-2xl font-black text-slate-800">${stats.WeeklyExercisesCompleted ?? stats.weeklyExercisesCompleted ?? 0}</p>
                        <p class="text-xs text-slate-400 font-bold">bài làm tuần này</p>
                    </div>
                    <div class="stat-card text-center">
                        <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center mx-auto mb-2">
                            <i class="fa-solid fa-book-open text-amber-600"></i>
                        </div>
                        <p class="text-2xl font-black text-slate-800">${stats.TotalLessonsCompleted ?? stats.totalLessonsCompleted ?? 0}</p>
                        <p class="text-xs text-slate-400 font-bold">bài học hoàn thành</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 fade-up">
                    <div class="glass p-6">
                        <h3 class="font-black text-slate-800 mb-5 flex items-center gap-2">
                            <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-list-check text-indigo-600 text-sm"></i>
                            </div>
                            Tiến độ từng chương
                        </h3>
                        ${chapters.length > 0 ? `
                            <div class="space-y-4">
                                ${chapters.map(c => {
                                    const pct = c.CompletionPercentage ?? c.completionPercentage ?? 0;
                                    const name = c.ChapterName || c.chapterName || '';
                                    const done = c.CompletedTopics ?? c.completedTopics ?? 0;
                                    const total = c.TotalTopics ?? c.totalTopics ?? 0;
                                    return `
                                    <div>
                                        <div class="flex items-center justify-between mb-1.5">
                                            <p class="font-bold text-slate-700 text-sm truncate max-w-[70%]">${name}</p>
                                            <span class="font-black text-xs ${pct >= 80 ? 'text-green-600' : pct >= 40 ? 'text-amber-500' : 'text-slate-400'}">${pct}%</span>
                                        </div>
                                        <div class="progress-bar">
                                            <div class="progress-fill ${pct >= 80 ? 'bg-green-500' : pct >= 40 ? 'bg-amber-400' : 'bg-indigo-400'}" style="width:${pct}%"></div>
                                        </div>
                                        <p class="text-[10px] text-slate-400 font-bold mt-1">${done}/${total} chủ đề</p>
                                    </div>`;
                                }).join('')}
                            </div>` : `
                            <div class="py-8 text-center">
                                <i class="fa-solid fa-book text-slate-200 text-3xl mb-3"></i>
                                <p class="text-slate-400 font-bold text-sm">Chưa có tiến độ</p>
                            </div>`}
                    </div>

                    <div class="glass p-6">
                        <h3 class="font-black text-slate-800 mb-5 flex items-center gap-2">
                            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-clock-rotate-left text-green-600 text-sm"></i>
                            </div>
                            Bài học gần đây
                        </h3>
                        ${lessons.length > 0 ? `
                            <div class="space-y-3">
                                ${lessons.map(l => {
                                    const name = l.LessonName || l.lessonName || l.TopicName || l.topicName || '';
                                    const chapter = l.ChapterName || l.chapterName || '';
                                    const score = l.Score ?? l.score;
                                    const tabSwitchCount = l.TabSwitchCount ?? l.tabSwitchCount ?? 0;
                                    
                                    return `
                                    <div class="flex flex-col gap-2 p-3 bg-slate-50 rounded-xl relative overflow-hidden">
                                        <div class="flex items-start gap-3">
                                            <div class="w-9 h-9 bg-indigo-100 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5">
                                                <i class="fa-solid fa-book-open text-indigo-600 text-xs"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="font-black text-slate-700 text-sm truncate">${name}</p>
                                                <p class="text-[11px] text-slate-400 font-bold">${chapter}</p>
                                            </div>
                                            ${score != null ? `
                                                <span class="text-xs font-black px-2 py-1 rounded-lg flex-shrink-0 ${score >= 8 ? 'bg-green-100 text-green-700' : score >= 5 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-600'}">
                                                    ${score}/10
                                                </span>` : ''}
                                        </div>
                                        ${tabSwitchCount > 0 ? `
                                            <div class="mt-1 flex items-center gap-2 bg-red-50 text-red-600 text-xs font-bold px-3 py-1.5 rounded-lg border border-red-100">
                                                <i class="fa-solid fa-triangle-exclamation"></i>
                                                <span>Cảnh báo: Vi phạm chuyển tab ${tabSwitchCount} lần!</span>
                                            </div>
                                        ` : ''}
                                    </div>`;
                                }).join('')}
                            </div>` : `
                            <div class="py-8 text-center">
                                <i class="fa-solid fa-book-open text-slate-200 text-3xl mb-3"></i>
                                <p class="text-slate-400 font-bold text-sm">Chưa có bài học nào</p>
                            </div>`}
                    </div>
                </div>`;
        }

        function showError(msg) {
            document.getElementById('report-content').innerHTML = `
                <div class="glass p-12 text-center">
                    <i class="fa-solid fa-circle-exclamation text-red-300 text-3xl mb-3"></i>
                    <p class="font-black text-slate-400">${msg}</p>
                </div>`;
        }

        init();
    </script>
</body>
</html>
