@* FILE: Views/Parent/Dashboard.cshtml *@
@{
    Layout = null;
    var parentName = ViewData["ParentName"]?.ToString() ?? User.Identity?.Name ?? "Phụ huynh";
    var firstName = parentName.Split(' ').Last();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Phụ Huynh - ToanHocHay</title>
    <link rel="icon" type="image/x-icon" href="/logo_header.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="/js/toast.js" defer></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: #F4F7FE;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-up {
            animation: fadeUp .4s ease both;
        }

        .d1 {
            animation-delay: .05s
        }

        .d2 {
            animation-delay: .1s
        }

        .d3 {
            animation-delay: .15s
        }

        .d4 {
            animation-delay: .2s
        }

        .glass {
            background: white;
            border-radius: 1.5rem;
            border: 1px solid #F1F5F9;
            box-shadow: 0 4px 20px rgba(0,0,0,.04);
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .75rem 1rem;
            border-radius: .75rem;
            color: #64748b;
            font-weight: 700;
            font-size: .875rem;
            transition: all .2s;
            text-decoration: none;
        }

            .sidebar-link:hover {
                background: #F1F5F9;
                color: #4f46e5;
                transform: translateX(3px);
            }

            .sidebar-link.active {
                background: #EEF2FF;
                color: #4f46e5;
            }

        .stat-card {
            background: white;
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid #F1F5F9;
            box-shadow: 0 4px 16px rgba(0,0,0,.04);
            transition: all .3s;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 24px rgba(0,0,0,.08);
            }
    </style>
</head>
<body>

    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="hidden lg:flex flex-col w-64 bg-white border-r border-gray-100 p-4 shadow-sm">
            <!-- Logo -->
            <div class="flex items-center gap-2 px-2 mb-8 mt-2">
                <img src="/logo_header.ico" class="w-8 h-8 object-contain">
                <span class="font-black text-lg bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">ToanHocHay</span>
            </div>

            <!-- Avatar -->
            <div class="flex items-center gap-3 px-2 mb-6 pb-6 border-b border-gray-100">
                <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-pink-500 rounded-2xl flex items-center justify-center text-white font-black text-lg shadow-md">
                    @parentName.FirstOrDefault()
                </div>
                <div>
                    <p class="font-black text-slate-800 text-sm leading-tight">@parentName</p>
                    <span class="text-[10px] bg-orange-100 text-orange-600 font-black px-2 py-0.5 rounded-full uppercase">Phụ huynh</span>
                </div>
            </div>

            <!-- Nav -->
            <nav class="space-y-1 flex-1">
                <a href="/Parent/Dashboard" class="sidebar-link active">
                    <i class="fa-solid fa-chart-pie w-5 text-center text-indigo-500"></i> Tổng quan
                </a>
                <a href="/Parent/Connection" class="sidebar-link">
                    <i class="fa-solid fa-link w-5 text-center"></i> Mã kết nối
                </a>
                <a href="/Parent/Report" class="sidebar-link">
                    <i class="fa-solid fa-chart-line w-5 text-center"></i> Báo cáo học tập
                </a>
            </nav>

            <!-- Logout -->
            <div class="border-t border-gray-100 pt-4 mt-4">
                <a href="/Account/Logout" class="sidebar-link text-red-500 hover:bg-red-50 hover:text-red-600">
                    <i class="fa-solid fa-right-from-bracket w-5 text-center"></i> Đăng xuất
                </a>
            </div>
        </aside>

        <!-- Main -->
        <main class="flex-1 p-6 lg:p-8 overflow-auto">

            <!-- Mobile header -->
            <div class="flex items-center justify-between mb-6 lg:hidden">
                <div class="flex items-center gap-2">
                    <img src="/logo_header.ico" class="w-7 h-7">
                    <span class="font-black text-indigo-700">ToanHocHay</span>
                </div>
                <div class="flex items-center gap-3">
                    <a href="/Parent/Connection" class="text-slate-500 hover:text-indigo-600"><i class="fa-solid fa-link"></i></a>
                    <a href="/Account/Logout" class="text-red-400 hover:text-red-600"><i class="fa-solid fa-right-from-bracket"></i></a>
                </div>
            </div>

            <!-- Welcome -->
            <div class="mb-8 fade-up d1">
                <h1 class="text-2xl font-black text-slate-800 mb-1">Xin chào, @firstName! 👋</h1>
                <p class="text-slate-400 font-bold text-sm">Theo dõi tiến trình học tập của con từ đây</p>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
                <div class="stat-card fade-up d1">
                    <div class="flex items-center justify-between mb-3">
                        <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Con đã kết nối</p>
                        <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center">
                            <i class="fa-solid fa-child text-blue-600"></i>
                        </div>
                    </div>
                    <p class="text-3xl font-black text-slate-800" id="stat-children">—</p>
                    <p class="text-xs text-slate-400 font-bold mt-1">học sinh</p>
                </div>
                <div class="stat-card fade-up d2">
                    <div class="flex items-center justify-between mb-3">
                        <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Mã kết nối</p>
                        <div class="w-10 h-10 bg-indigo-100 rounded-xl flex items-center justify-center">
                            <i class="fa-solid fa-qrcode text-indigo-600"></i>
                        </div>
                    </div>
                    <p class="text-lg font-black text-indigo-700 tracking-widest" id="stat-code">——————</p>
                    <a href="/Parent/Connection" class="text-xs text-indigo-500 font-black mt-1 hover:underline inline-block">Xem & chia sẻ →</a>
                </div>
                <div class="stat-card fade-up d3">
                    <div class="flex items-center justify-between mb-3">
                        <p class="text-xs font-black text-slate-400 uppercase tracking-widest">Trạng thái</p>
                        <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center">
                            <i class="fa-solid fa-circle-check text-green-600"></i>
                        </div>
                    </div>
                    <p class="text-lg font-black text-green-600">Hoạt động</p>
                    <p class="text-xs text-slate-400 font-bold mt-1">Tài khoản phụ huynh</p>
                </div>
            </div>

            <!-- Children list -->
            <div class="glass p-6 mb-8 fade-up d3">
                <div class="flex items-center justify-between mb-5">
                    <h2 class="font-black text-slate-800 flex items-center gap-2">
                        <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                            <i class="fa-solid fa-users text-blue-600 text-sm"></i>
                        </div>
                        Danh sách con đã kết nối
                    </h2>
                    <a href="/Parent/Connection"
                       class="text-xs font-black text-indigo-600 hover:underline flex items-center gap-1">
                        <i class="fa-solid fa-plus text-[10px]"></i> Thêm kết nối
                    </a>
                </div>
                <div id="children-list">
                    <div class="py-16 text-center">
                        <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                            <i class="fa-solid fa-spinner fa-spin text-slate-300 text-2xl"></i>
                        </div>
                        <p class="text-slate-400 font-bold text-sm">Đang tải...</p>
                    </div>
                </div>
            </div>

            <!-- Quick actions -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 fade-up d4">
                <a href="/Parent/Connection"
                   class="glass p-6 flex items-center gap-4 hover:shadow-lg transition group cursor-pointer">
                    <div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-2xl flex items-center justify-center text-white text-xl shadow-lg group-hover:scale-110 transition">
                        <i class="fa-solid fa-link"></i>
                    </div>
                    <div>
                        <p class="font-black text-slate-800">Mã kết nối</p>
                        <p class="text-xs text-slate-400 font-bold">Chia sẻ mã cho con để kết nối</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-300 ml-auto group-hover:text-indigo-500 transition"></i>
                </a>

                <a href="/Parent/Report"
                   class="glass p-6 flex items-center gap-4 hover:shadow-lg transition group cursor-pointer">
                    <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center text-white text-xl shadow-lg group-hover:scale-110 transition">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <p class="font-black text-slate-800">Báo cáo học tập</p>
                        <p class="text-xs text-slate-400 font-bold">Xem tiến độ học của con</p>
                    </div>
                    <i class="fa-solid fa-chevron-right text-slate-300 ml-auto group-hover:text-green-500 transition"></i>
                </a>
            </div>

        </main>
    </div>

    <script>
        const parentId = '@User.FindFirst("ParentId")?.Value';

        async function loadParentData() {
            try {
                const res  = await fetch(`/Parent/GetInfo`);
                const data = await res.json();

                if (data.connectionCode) {
                    document.getElementById('stat-code').textContent = data.connectionCode;
                }
                if (data.children && data.children.length > 0) {
                    document.getElementById('stat-children').textContent = data.children.length;
                    renderChildren(data.children);
                } else {
                    renderNoChildren();
                }
            } catch {
                renderNoChildren();
            }
        }

        function renderChildren(children) {
            const colors = ['from-blue-400 to-sky-500', 'from-purple-400 to-violet-500',
                            'from-green-400 to-emerald-500', 'from-orange-400 to-amber-500'];
            document.getElementById('children-list').innerHTML = `
                <div class="space-y-3">
                    ${children.map((c, i) => `
                        <div class="flex items-center justify-between p-4 bg-blue-50/50 rounded-xl border border-blue-100">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 bg-gradient-to-br ${colors[i % colors.length]} rounded-xl flex items-center justify-center font-black text-white text-lg shadow-md">
                                    ${(c.fullName || c.FullName || '?')[0]}
                                </div>
                                <div>
                                    <p class="font-black text-slate-800">${c.fullName || c.FullName || 'Học sinh'}</p>
                                    <p class="text-xs text-slate-400 font-bold">Lớp ${c.gradeLevel || c.GradeLevel || 6}</p>
                                </div>
                            </div>
                            <span class="text-xs bg-green-100 text-green-700 font-black px-3 py-1 rounded-full flex items-center gap-1">
                                <i class="fa-solid fa-circle-check text-[10px]"></i> Đã kết nối
                            </span>
                        </div>
                    `).join('')}
                </div>`;
        }

        function renderNoChildren() {
            document.getElementById('stat-children').textContent = '0';
            document.getElementById('children-list').innerHTML = `
                <div class="py-16 text-center">
                    <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-user-plus text-slate-300 text-2xl"></i>
                    </div>
                    <p class="font-black text-slate-400 text-sm mb-2">Chưa có học sinh nào kết nối</p>
                    <a href="/Parent/Connection"
                       class="inline-block px-5 py-2 bg-indigo-600 text-white font-black text-xs rounded-xl hover:bg-indigo-700 transition">
                        Xem mã kết nối
                    </a>
                </div>`;
        }

        loadParentData();
    </script>
    <partial name="_ToastHost" />
</body>
</html>
