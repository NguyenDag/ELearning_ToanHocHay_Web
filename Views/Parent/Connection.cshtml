@* FILE: Views/Parent/Connection.cshtml *@
@{
    Layout = null;
    var parentName = ViewData["ParentName"]?.ToString() ?? User.Identity?.Name ?? "Phụ huynh";
    var connectionCode = ViewData["ConnectionCode"]?.ToString() ?? "--------";
    var codePart1 = connectionCode.Length >= 4 ? connectionCode[..4] : connectionCode;
    var codePart2 = connectionCode.Length >= 8 ? connectionCode[4..8] : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mã kết nối - ToanHocHay</title>
    <link rel="icon" type="image/x-icon" href="/logo_header.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: #F4F7FE;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-up {
            animation: fadeUp .4s ease both;
        }

        .d1 {
            animation-delay: .05s
        }

        .d2 {
            animation-delay: .1s
        }

        .d3 {
            animation-delay: .15s
        }

        .glass {
            background: white;
            border-radius: 1.5rem;
            border: 1px solid #F1F5F9;
            box-shadow: 0 4px 20px rgba(0,0,0,.04);
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .75rem 1rem;
            border-radius: .75rem;
            color: #64748b;
            font-weight: 700;
            font-size: .875rem;
            transition: all .2s;
            text-decoration: none;
        }

            .sidebar-link:hover {
                background: #F1F5F9;
                color: #4f46e5;
                transform: translateX(3px);
            }

            .sidebar-link.active {
                background: #EEF2FF;
                color: #4f46e5;
            }

        @@keyframes glow-pulse {
            0%, 100% {
                box-shadow: 0 0 20px rgba(165,180,252,.3);
            }

            50% {
                box-shadow: 0 0 40px rgba(165,180,252,.6);
            }
        }

        .glow {
            animation: glow-pulse 2s ease infinite;
        }
    </style>
</head>
<body>
    <div class="flex min-h-screen">

        <!-- Sidebar — giống hệt Dashboard -->
        <aside class="hidden lg:flex flex-col w-64 bg-white border-r border-gray-100 p-4 shadow-sm">
            <div class="flex items-center gap-2 px-2 mb-8 mt-2">
                <img src="/logo_header.ico" class="w-8 h-8 object-contain">
                <span class="font-black text-lg bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">ToanHocHay</span>
            </div>
            <div class="flex items-center gap-3 px-2 mb-6 pb-6 border-b border-gray-100">
                <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-pink-500 rounded-2xl flex items-center justify-center text-white font-black text-lg shadow-md">
                    @parentName.FirstOrDefault()
                </div>
                <div>
                    <p class="font-black text-slate-800 text-sm leading-tight">@parentName</p>
                    <span class="text-[10px] bg-orange-100 text-orange-600 font-black px-2 py-0.5 rounded-full uppercase">Phụ huynh</span>
                </div>
            </div>
            <nav class="space-y-1 flex-1">
                <a href="/Parent/Dashboard" class="sidebar-link">
                    <i class="fa-solid fa-chart-pie w-5 text-center"></i> Tổng quan
                </a>
                <a href="/Parent/Connection" class="sidebar-link active">
                    <i class="fa-solid fa-link w-5 text-center text-indigo-500"></i> Mã kết nối
                </a>
                <a href="/Parent/Report" class="sidebar-link">
                    <i class="fa-solid fa-chart-line w-5 text-center"></i> Báo cáo học tập
                </a>
            </nav>
            <div class="border-t border-gray-100 pt-4 mt-4">
                <a href="/Account/Logout" class="sidebar-link text-red-500 hover:bg-red-50 hover:text-red-600">
                    <i class="fa-solid fa-right-from-bracket w-5 text-center"></i> Đăng xuất
                </a>
            </div>
        </aside>

        <!-- Main -->
        <main class="flex-1 p-6 lg:p-8 overflow-auto">

            <!-- Mobile header -->
            <div class="flex items-center justify-between mb-6 lg:hidden">
                <div class="flex items-center gap-2">
                    <img src="/logo_header.ico" class="w-7 h-7">
                    <span class="font-black text-indigo-700">ToanHocHay</span>
                </div>
                <div class="flex items-center gap-3">
                    <a href="/Parent/Dashboard" class="text-slate-500 hover:text-indigo-600"><i class="fa-solid fa-chart-pie"></i></a>
                    <a href="/Account/Logout" class="text-red-400 hover:text-red-600"><i class="fa-solid fa-right-from-bracket"></i></a>
                </div>
            </div>

            <!-- Page title -->
            <div class="mb-8 fade-up d1">
                <h1 class="text-2xl font-black text-slate-800 mb-1">Mã kết nối 🔗</h1>
                <p class="text-slate-400 font-bold text-sm">Chia sẻ mã này cho con để liên kết tài khoản</p>
            </div>

            <!-- Code Hero -->
            <div class="glow mb-8 fade-up d2 rounded-3xl overflow-hidden"
                 style="background: linear-gradient(135deg, #312e81 0%, #4c1d95 50%, #1e1b4b 100%); padding: 3rem 2rem; text-align:center; position:relative;">
                <div class="absolute inset-0" style="background: radial-gradient(circle at 30% 50%, rgba(165,180,252,.15) 0%, transparent 60%), radial-gradient(circle at 70% 50%, rgba(196,181,253,.1) 0%, transparent 60%);"></div>
                <div class="absolute top-0 right-0 w-40 h-40 bg-white/5 rounded-full translate-x-1/2 -translate-y-1/2"></div>
                <div class="absolute bottom-0 left-0 w-32 h-32 rounded-full -translate-x-1/2 translate-y-1/2" style="background:rgba(139,92,246,.1)"></div>

                <div class="relative z-10">
                    <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-5" style="background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2);">
                        <i class="fa-solid fa-qrcode text-white text-2xl"></i>
                    </div>
                    <p class="text-indigo-200 font-black text-xs uppercase tracking-[.3em] mb-4">Mã kết nối của bạn</p>
                    <div class="font-black text-white mb-6"
                         style="font-family:'Courier New',monospace; font-size:clamp(2rem,6vw,3.5rem); letter-spacing:.15em; text-shadow: 0 0 30px rgba(165,180,252,.6);">
                        <span>@codePart1</span>
                        <span style="color:rgba(165,180,252,.6); margin:0 .5rem">—</span>
                        <span>@codePart2</span>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3 justify-center">
                        <button onclick="copyCode()" id="copy-btn"
                                class="flex items-center justify-center gap-2 px-8 py-3 bg-white text-indigo-700 font-black rounded-2xl text-sm hover:bg-indigo-50 transition shadow-lg">
                            <i class="fa-regular fa-copy" id="copy-icon"></i>
                            <span id="copy-text">Sao chép mã</span>
                        </button>
                        <button onclick="shareCode()"
                                class="flex items-center justify-center gap-2 px-8 py-3 font-black rounded-2xl text-sm text-white transition"
                                style="background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2);">
                            <i class="fa-solid fa-share-nodes"></i> Chia sẻ
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 fade-up d3">

                <!-- Học sinh đã kết nối -->
                <div class="glass p-6">
                    <div class="flex items-center justify-between mb-5">
                        <h3 class="font-black text-slate-800 flex items-center gap-2">
                            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
                                <i class="fa-solid fa-child text-blue-600 text-sm"></i>
                            </div>
                            Con đã kết nối
                        </h3>
                    </div>
                    <div id="children-list">
                        <div class="py-10 text-center">
                            <i class="fa-solid fa-spinner fa-spin text-slate-300 text-2xl mb-3"></i>
                            <p class="text-slate-400 font-bold text-sm">Đang tải...</p>
                        </div>
                    </div>
                </div>

                <!-- Hướng dẫn -->
                <div class="glass p-6">
                    <h3 class="font-black text-slate-800 mb-5 flex items-center gap-2">
                        <div class="w-8 h-8 bg-amber-100 rounded-lg flex items-center justify-center">
                            <i class="fa-solid fa-circle-info text-amber-600 text-sm"></i>
                        </div>
                        Cách kết nối
                    </h3>
                    <ol class="space-y-4">
                        @{
                            var steps = new[] {
                                                ("Sao chép mã",  "Nhấn nút Sao chép mã bên trên",                    "indigo"),
                                                ("Gửi cho con",  "Gửi mã qua tin nhắn hoặc nói trực tiếp",           "blue"),
                                                ("Con nhập mã",  "Con vào Hồ sơ → Kết nối phụ huynh → nhập mã",     "purple"),
                                                ("Kết nối xong", "Tên con sẽ hiện trong danh sách bên trái",         "green"),
                                                };
                            int n = 1;
                        }
                        @foreach (var (title, desc, color) in steps)
                        {
                            <li class="flex items-start gap-3">
                                <div class="w-8 h-8 bg-@(color)-100 text-@(color)-600 rounded-xl flex items-center justify-center font-black text-sm flex-shrink-0 mt-0.5">
                                    @(n++)
                                </div>
                                <div>
                                    <p class="font-black text-slate-700 text-sm">@title</p>
                                    <p class="text-xs text-slate-400 font-bold">@desc</p>
                                </div>
                            </li>
                        }
                    </ol>
                </div>
            </div>

            <!-- Note -->
            <div class="mt-6 glass p-5 fade-up d3" style="border:1px solid #fde68a; background:rgba(255,251,235,.5);">
                <div class="flex gap-3">
                    <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 flex-shrink-0"></i>
                    <p class="text-sm text-slate-600 font-bold">
                        Mã của bạn là <b class="text-indigo-700 tracking-widest">@connectionCode</b> — cố định và duy nhất. Chỉ chia sẻ với con của bạn.
                    </p>
                </div>
            </div>

        </main>
    </div>

    <script>
        const CODE = '@connectionCode';

        async function loadChildren() {
            try {
                const res  = await fetch('/Parent/GetInfo');
                const data = await res.json();
                if (data.children && data.children.length > 0) {
                    renderChildren(data.children);
                } else {
                    renderNoChildren();
                }
            } catch { renderNoChildren(); }
        }

        function renderChildren(children) {
            const colors = ['from-blue-400 to-sky-500','from-purple-400 to-violet-500',
                            'from-green-400 to-emerald-500','from-orange-400 to-amber-500'];
            document.getElementById('children-list').innerHTML = `
                <div class="space-y-3">
                    ${children.map((c,i) => `
                        <div class="flex items-center justify-between p-4 bg-blue-50/50 rounded-xl border border-blue-100">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-gradient-to-br ${colors[i%colors.length]} rounded-xl flex items-center justify-center font-black text-white shadow-md">
                                    ${(c.fullName||c.FullName||'?')[0]}
                                </div>
                                <div>
                                    <p class="font-black text-slate-800 text-sm">${c.fullName||c.FullName||'Học sinh'}</p>
                                    <p class="text-xs text-slate-400 font-bold">Lớp ${c.gradeLevel||c.GradeLevel||6}</p>
                                </div>
                            </div>
                            <i class="fa-solid fa-circle-check text-sky-500 text-lg"></i>
                        </div>`).join('')}
                </div>`;
        }

        function renderNoChildren() {
            document.getElementById('children-list').innerHTML = `
                <div class="py-10 text-center">
                    <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-user-plus text-slate-300 text-2xl"></i>
                    </div>
                    <p class="font-black text-slate-400 text-sm">Chưa có học sinh nào kết nối</p>
                    <p class="text-xs text-slate-300 font-bold mt-1">Chia sẻ mã cho con để bắt đầu</p>
                </div>`;
        }

        function copyCode() {
            navigator.clipboard.writeText(CODE).then(() => {
                const btn  = document.getElementById('copy-btn');
                const icon = document.getElementById('copy-icon');
                const text = document.getElementById('copy-text');
                icon.className = 'fa-solid fa-check';
                text.textContent = 'Đã sao chép!';
                btn.classList.add('bg-green-50','text-green-700');
                btn.classList.remove('bg-white','text-indigo-700');
                setTimeout(() => {
                    icon.className = 'fa-regular fa-copy';
                    text.textContent = 'Sao chép mã';
                    btn.classList.remove('bg-green-50','text-green-700');
                    btn.classList.add('bg-white','text-indigo-700');
                }, 2000);
            });
        }

        function shareCode() {
            if (navigator.share) {
                navigator.share({ title:'Mã kết nối ToanHocHay',
                    text:`Mã kết nối: ${CODE}\nVào Hồ sơ → Kết nối phụ huynh để nhập mã.` });
            } else { copyCode(); }
        }

        loadChildren();
    </script>
</body>
</html>
