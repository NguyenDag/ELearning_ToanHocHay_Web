{
  // ---------------------------------------------------------------------------
  // MẪU cấu hình cho ToanHocHay.WebApp.
  // Cách dùng: sao chép file này thành "appsettings.json" (đã bị .gitignore)
  // rồi điền giá trị thật.
  // Prod: có thể đè từng khoá bằng biến môi trường (Api__BaseUrl, Session__IdleTimeoutMinutes, ...).
  // ---------------------------------------------------------------------------

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Api": {
    // URL gốc Backend API (KHÔNG kèm "/api").
    // ⚠️ Dev: DÙNG ĐÚNG SCHEME + PORT HTTPS của backend (vd https://localhost:7290).
    //    Nếu trỏ vào cổng http (vd http://localhost:5052) mà backend bật UseHttpsRedirection,
    //    request sẽ bị 307 sang https và HttpClient CÓ THỂ rớt header Authorization
    //    → gọi API cần đăng nhập trả 401 (danh sách quản trị trống). Xem log để chắc chắn.
    "BaseUrl": "https://localhost:7290",

    // URL công khai của chính WebApp (dùng cho liên kết tuyệt đối / email).
    "WebBaseUrl": "https://localhost:7299"
  },

  "Session": {
    // Thời gian sống của session (phút).
    "IdleTimeoutMinutes": 60
  },

  "Auth": {
    // Số ngày giữ cookie đăng nhập. Nên đặt gần với thời hạn refresh token của backend.
    "CookieExpireDays": 7
  }
}
