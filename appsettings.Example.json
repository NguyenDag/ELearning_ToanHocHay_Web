{
  // ---------------------------------------------------------------------------
  // MẪU cấu hình cho ToanHocHay.WebApp.
  // Cách dùng: sao chép file này thành "appsettings.json" (đã bị .gitignore)
  // rồi điền giá trị thật. Có thể ghi đè bằng .env hoặc biến môi trường
  // (Api__BaseUrl, Session__IdleTimeoutMinutes, ...).
  // ---------------------------------------------------------------------------

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Api": {
    // URL gốc Backend API (KHÔNG kèm "/api"). Ví dụ:
    //   http://103.98.152.182  |  https://localhost:7290  |  http://localhost:5052
    "BaseUrl": "http://localhost:5052",

    // URL công khai của chính WebApp (dùng cho liên kết tuyệt đối / email).
    "WebBaseUrl": "https://localhost:7299"
  },

  "Session": {
    // Thời gian sống của session (phút).
    "IdleTimeoutMinutes": 60
  },

  "Auth": {
    // Số ngày giữ cookie đăng nhập. Nên đặt gần với thời hạn refresh token của backend.
    "CookieExpireDays": 7
  }
}
