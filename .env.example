# ============================================================================
# MẪU biến môi trường cho ToanHocHay.WebApp.
# Cách dùng: sao chép thành ".env" (đã bị .gitignore) rồi điền giá trị thật.
# Dấu phân cấp là "__" (hai gạch dưới):  Api__BaseUrl  ↔  "Api": { "BaseUrl": ... }
# File .env chỉ điền vào chỗ chưa có biến môi trường thật; biến thật luôn ưu tiên.
# ============================================================================

# Môi trường chạy: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# URL gốc Backend API (KHÔNG kèm "/api")
#   local:  http://localhost:5052   hoặc   https://localhost:7290
#   server: http://103.98.152.182
Api__BaseUrl=http://localhost:5052

# URL công khai của chính WebApp
Api__WebBaseUrl=https://localhost:7299

# Thời gian sống session (phút)
Session__IdleTimeoutMinutes=60

# Số ngày giữ cookie đăng nhập (nên gần với thời hạn refresh token của backend)
Auth__CookieExpireDays=7
